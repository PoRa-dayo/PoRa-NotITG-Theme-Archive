        File="ScreenSelectMusic stage 2.png"
        Command="xywh,SCREEN_CENTER_X,SCREEN_CENTER_Y,2048,1024;customtexturerect,0,0,2,1;texcoordvelocity,-0.06,0;diffusealpha,0.5"
        Condition="GAMESTATE:StageIndex() == 1"
