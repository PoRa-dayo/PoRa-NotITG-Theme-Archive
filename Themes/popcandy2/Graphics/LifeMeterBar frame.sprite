[Sprite]
Texture=_LifeMB frame
InitCommand=%function(self) if (not IsFinalStage()) then if PopCandyGameplayIsOriginal() then self:Load(THEME:GetPath(EC_GRAPHICS,'','_ORILifeMB frame')) end elseif PopCandyGameplayIsOriginal() then self:Load(THEME:GetPath(EC_GRAPHICS,'','_ORILifeMBExtra frame')) else self:Load(THEME:GetPath(EC_GRAPHICS,'','_LifeMBExtra frame')) end end