<ActorFrame> <children>

	<!-- These are the name tab panes.  You don't set the positions of the actual names or selection brace examples here;
	you set those in Graphics/_name p1 (or p2). -->
	<Layer File="../ScreenOptions overlay" />

	<Layer 
		Condition="GAMESTATE:IsHumanPlayer(PLAYER_1)"
		OnCommand="x,120;y,81;addx,SCREEN_WIDTH*3/4;sleep,0.1;decelerate,0.3;addx,-SCREEN_WIDTH*3/4"
		OffCommand="accelerate,0.3;addx,SCREEN_WIDTH"
		File="@THEME:GetPath(EC_GRAPHICS,'','_name p1')"
	/>

	<Layer
		Condition="GAMESTATE:IsHumanPlayer(PLAYER_2)"
		OnCommand="x,520;y,81;addx,SCREEN_WIDTH*3/4;sleep,0.2;decelerate,0.3;addx,-SCREEN_WIDTH*3/4"
		OffCommand="accelerate,0.3;addx,SCREEN_WIDTH"
		File="@THEME:GetPath(EC_GRAPHICS,'','_name p2')"
	/>

<!-- Title/Artist Display -->
<!--
<Layer
   Type="BitmapText"
   Font="_eurostile blue glow"
   Text="You Are About to Play"
   InitCommand="DiffuseAlpha,1"
   OnCommand="X,SCREEN_CENTER_X+81;Y,SCREEN_TOP+16;Zoom,0.35;shadowlength,1;horizalign,center;AddY,-100;decelerate,0.3;addy,+100"
   OffCommand="accelerate,0.3;addy,-100"
/>
-->

<!-- The song name pane. -->
<Layer
   File="Song Name Pane"
   InitCommand="DiffuseAlpha,1"
   OnCommand="X,SCREEN_CENTER_X;Y,SCREEN_TOP+66;AddY,-100;decelerate,0.3;addy,+100"
   OffCommand="accelerate,0.3;addy,-100"
/>

	<!-- Song or course title. -->
	<Layer Type="ActorFrame"
		OnCommand="X,SCREEN_CENTER_X;Y,SCREEN_TOP+32;shadowlength,2;AddY,-100;decelerate,0.3;addy,+100"
		OffCommand="accelerate,0.3;addy,-100"
		> <children>

		<Layer
			Condition="not GAMESTATE:IsCourseMode()"
			Type="BitmapText"
			Font="_v profile"
			InitCommand="animate,0;playcommand,Update"
			OnCommand="Y,30;zoom,.55;shadowlength,0;maxwidth,340"
			OffCommand=""
			CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self) self:settext(GAMESTATE:GetCurrentSong():GetDisplayFullTitle()) end"
		/>

		<Layer
			Condition="GAMESTATE:IsCourseMode()"
			Type="BitmapText"
			Font="_v profile"
			InitCommand="animate,0;playcommand,Update"
			OnCommand="Y,30;zoom,.7;shadowlength,0;maxwidth,340"
			OffCommand=""
			CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self) self:settext(GAMESTATE:GetCurrentCourse():GetDisplayFullTitle()) end"
		/>
        
        		
        <!-- BPM display. -->
        <Layer
            Type="BitmapText"
            Font="_v profile"
            InitCommand="animate,0;playcommand,Update"
            OnCommand="Y,53;zoom,.5;shadowlength,0;maxwidth,340"
            OffCommand=""
            UpdateCommand="%function(self)
                if bpm[2] ~= '' then
                    self:settext('BPM: '..bpm[1]..'-'..bpm[2])
                else
                    self:settext('BPM: '..bpm[1])
                end
            end"
        />
	</children> </Layer>

    <!-- Artist, or designation that this is a course of some sort. -->
	<Layer Type="ActorFrame"
		OnCommand="X,SCREEN_CENTER_X;Y,SCREEN_TOP+72;shadowlength,2;AddY,-100;decelerate,0.3;addy,+100"
		OffCommand="accelerate,0.3;addy,-100"
		> <children>

		<Layer
			Condition="not GAMESTATE:IsCourseMode()"
			Type="BitmapText"
			Font="_v profile"
			InitCommand="animate,0;playcommand,Update"
			OnCommand="Y,-1;zoom,.4;shadowlength,0;maxwidth,580"
			OffCommand=""
			UpdateCommand="%function(self) self:settext(GAMESTATE:GetCurrentSong():GetDisplayArtist()) end"
		/>

		<Layer
			Condition="GAMESTATE:IsCourseMode()"
			Type="BitmapText"
			Font="_v profile"
			OnCommand="Y,1;zoom,.4;shadowlength,0;maxwidth,580;DiffuseShift;EffectColor1,#FFFF55;EffectColor2,#FFFF55"
			OffCommand=""
			Text="(Marathon Course)"
		/>
        
        <!-- Composite speed mod displays for P1 and P2.  This is *just* the actual text, not any panes they appear to be in. -->		
        <Layer
                Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
                Font="_v profile"
                Text="Mod:"
                Command="@'diffuse,' .. PlayerColor(PLAYER_1) .. ';x,SCREEN_CENTER_X-582;y,SCREEN_TOP+10;zoom,0.45;ShadowLength,2;horizalign,left;queuecommand,Update;addx,-SCREEN_WIDTH*3/4;sleep,0.2;decelerate,0.6;addx,SCREEN_WIDTH*3/4'"
                SpeedModChangedMessageCommand="queuecommand,Update"
                UpdateCommand="%function(self) self:settext('Speed Mod: '..DisplaySpeedMod(1)) end"
                OffCommand="zoom,0"
            />

        <Layer
                Condition="GAMESTATE:IsPlayerEnabled(PLAYER_2)"
                Font="_v profile"
                Text="Mod:"
                Command="@'diffuse,' .. PlayerColor(PLAYER_2) .. ';x,SCREEN_CENTER_X-182;y,SCREEN_TOP+10;zoom,0.45;ShadowLength,2;horizalign,left;queuecommand,Update;addx,SCREEN_WIDTH*3/4;sleep,0.2;decelerate,0.6;addx,-SCREEN_WIDTH*3/4'"
                SpeedModChangedMessageCommand="queuecommand,Update"
                UpdateCommand="%function(self) self:settext('Speed Mod: '..DisplaySpeedMod(2)) end"
                OffCommand="zoom,0"
            />

</children> </Layer>
</children> </ActorFrame>
