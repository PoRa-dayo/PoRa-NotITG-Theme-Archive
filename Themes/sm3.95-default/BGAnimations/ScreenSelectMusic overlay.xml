<ActorFrame
    CurrentSongChangedMessageCommand="queuecommand,SendUpdate"
    CurrentStepsP1ChangedMessageCommand="queuecommand,SendUpdate"
    CurrentStepsP2ChangedMessageCommand="queuecommand,SendUpdate"
    SendUpdateCommand="%function(self)
    MESSAGEMAN:Broadcast('Update')
    end"
    ><children>
    <Layer
        Font="../Numbers/ScreenSelectMusic total time"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="zoom,0.5;x,SCREEN_CENTER_X-230;y,SCREEN_CENTER_Y+191;rainbow;effectperiod,2;horizalign,center;shadowlength,2;"
        OffCommand="diffusealpha,1;accelerate,0.25;diffusealpha,0"
        UpdateMessageCommand="%function(self) LevelNum(self, PLAYER_1) end"
    />
    
    <Layer
        Font="../Numbers/ScreenSelectMusic total time"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_2)"
        OnCommand="zoom,0.5;x,SCREEN_CENTER_X-90;y,SCREEN_CENTER_Y+191;rainbow;effectperiod,2;horizalign,center;shadowlength,2;"
        OffCommand="diffusealpha,1;accelerate,0.25;diffusealpha,0"
        UpdateMessageCommand="%function(self) LevelNum(self, PLAYER_2) end" />
        
        
    <Layer
        Type="BitmapText"
        Font="_shared2"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="draworder,102;zoom,0.5;x,SCREEN_CENTER_X-320;y,SCREEN_CENTER_Y-20;horizalign,left;shadowlength,0;maxwidth,300"
        OffCommand="diffusealpha,1;accelerate,0.25;diffusealpha,0"
        UpdateMessageCommand="%function(self) self:settext(GetStepsDescriptionText(PLAYER_1)) end" />
    <Layer
        Type="BitmapText"
        Font="_shared2"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_2)"
        OnCommand="draworder,102;zoom,0.5;x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-20;horizalign,right;shadowlength,0;maxwidth,300"
        OffCommand="diffusealpha,1;accelerate,0.25;diffusealpha,0"
        UpdateMessageCommand="%function(self) self:settext(GetStepsDescriptionText(PLAYER_2)) end" />
    
</children></ActorFrame>