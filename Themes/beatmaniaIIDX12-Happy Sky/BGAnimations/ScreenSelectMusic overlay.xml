    #DIFFICULTY SHINE
    <Layer
        File="_DifficultyShine"
        Condition="FUCK_EXE"
        OnCommand="%function(self)
            self:blend('add')
            self:x(SCREEN_CENTER_X-83)
            self:y(SCREEN_CENTER_Y+34)
            self:diffusealpha(0)
            self:sleep(1)
            self:queuecommand('Shine')
        end"
        ShineCommand="%function(self)
            local DiffList = SCREENMAN:GetTopScreen():GetChild('DifficultyList')
            local DiffRow
            local DiffName
            local DiffNum=0
            for RowInd=0,22 do
                local ele = DiffList:GetChildAt(RowInd)
                if ele ~= DiffList:GetChild('CursorP1') and ele ~= DiffList:GetChild('CursorP2') and ele:GetY() > -1 and ele:GetY() < 28 then
                    DiffRow = ele
                    break
                end
            end
            if DiffRow then
                DiffNum = tonumber(DiffRow:GetChild('Meter'):GetText())
                DiffName = DiffRow:GetChild('Difficulty'):GetText()
                for SlotInd=0,5 do
                    if DifficultyToThemedString(SlotInd) == DiffName then
                        DiffuseDifficultyColor(self,SlotInd)
                    end
                end
            end
            if not DiffNum then DiffNum=0 end
            DiffNum = math.min(DiffNum,12)
            self:diffusealpha(0.5)
            self:cropright(1)
            self:linear(0.3/12*DiffNum)
            self:cropright(1/12*(12-DiffNum))
            self:linear(1)
            self:diffusealpha(0)
            self:sleep(0.3-0.3/12*DiffNum)
            self:queuecommand('Shine')
        end"
    />
    <Layer
        File="_DifficultyShine"
