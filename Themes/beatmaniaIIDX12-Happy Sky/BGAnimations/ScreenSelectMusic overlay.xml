--better avoid using GAMESTATE:GetEasiestStepsDifficulty() too many times as it lowers performance
--WheelSelect and UpdateScroll have to be called continuously to not be faulty
<ActorFrame
    OnCommand="queuecommand,UpdateScroll"
    CurrentSongChangedMessageCommand="%function(self)
        MESSAGEMAN:Broadcast('Update')
        MESSAGEMAN:Broadcast('SongUpdate')
    end"
    CurrentStepsP1ChangedMessageCommand="%function(self)
        if not GAMESTATE:IsCourseMode() then
            local temp = GAMESTATE:GetEasiestStepsDifficulty()
            if temp < 6 then
                BMIIDX12Glob.CurDiff = GAMESTATE:GetEasiestStepsDifficulty()
            end
        end
        MESSAGEMAN:Broadcast('Update')
    end"
    CurrentStepsP2ChangedMessageCommand="%function(self)
        if not GAMESTATE:IsCourseMode() then
            local temp = GAMESTATE:GetEasiestStepsDifficulty()
            if temp < 6 then
                BMIIDX12Glob.CurDiff = GAMESTATE:GetEasiestStepsDifficulty()
            end
        end
        MESSAGEMAN:Broadcast('Update')
    end"
    UpdateScrollCommand="%function(self)
        if BMIIDX12Glob.ScrollUpdateNOW then return end
        BMIIDX12Glob.ScrollUpdateNOW=true
        self:queuecommand('Scroll')
    end"
    ScrollCommand="%function(self)
        if BMIIDX12Glob.ScrollUpdateNOW then
            MESSAGEMAN:Broadcast('UpdateScrollThumb')
            self:sleep(0.1)
            self:queuecommand('UpdateScroll')
            self:queuecommand('WheelSelect')
        end
        BMIIDX12Glob.ScrollUpdateNOW = false
    end"
    WheelSelectCommand="%function(self)
        UpdateWheelSelection()
    end"
    ><children>
    
        
    <!--CurrentSongChanged is not used here because the Artist commands in [TextBanner] in metrics.ini do a better job. -->
    <!--As CurrentSongChanged is not activated when the player opens a group. -->
    <!--The YouShouldChangeThatShitNOW is to minimize the amount of times UpdateWheelTitles gets called-->
    <!--Similarly, ScrollUpdateNOW is to minimize the amount of times UpdateWheelSelection gets called-->
    <Layer
        Type="Quad"
        OnCommand="%function(self)
            BMIIDX12Glob.MusicWheelList = {}
            BMIIDX12Glob.ArtistTitles = {}
            BMIIDX12Glob.DiffNumTitles = {}
            BMIIDX12Glob.SelectedWheelItems = {}
            BMIIDX12Glob.FirstTweening=true
            BMIIDX12Glob.Rand=1
            BMIIDX12Glob.DirCompare=nil
            self:sleep(0.1)
            self:queuecommand('FirstUpdate')
            self:sleep(0.5)
            self:queuecommand('Disallow')
        end"
        DisallowCommand="%function(self)
            BMIIDX12Glob.FirstTweening=false
        end"
        FirstUpdateCommand="%function(self)
            UpdateWheelTitles(true)
            BMIIDX12Glob.YouShouldChangeThatShitNOW = false
            BMIIDX12Glob.ScrollUpdateNOW = false
        end"
        UpdateMessageCommand="%function(self)
            if BMIIDX12Glob.YouShouldChangeThatShitNOW then return end
            BMIIDX12Glob.YouShouldChangeThatShitNOW=true
            self:queuecommand('Wheel')
        end"
        WheelCommand="%function(self)
            if BMIIDX12Glob.YouShouldChangeThatShitNOW then
                UpdateWheelTitles()
            end
            BMIIDX12Glob.YouShouldChangeThatShitNOW = false
        end"/>
        
        
