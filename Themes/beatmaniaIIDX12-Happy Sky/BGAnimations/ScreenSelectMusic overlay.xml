    <Layer
        Type="ActorFrame"
        Condition="FUCK_EXE"
        OnCommand="x,SCREEN_WIDTH-98+102-18;y,SCREEN_CENTER_Y-15"
        UpdateScrollThumbMessageCommand="queuecommand,UpdateThumb"
        CurrentSongChangedMessageCommand="%function(self)
            if not BMIIDX12Glob.FirstTweening then
                BMIIDX12Glob.PrevCWI = CurWheelIndex()
                if BMIIDX12Glob.MusicWheelList[BMIIDX12Glob.PrevCWI] then
                    BMIIDX12Glob.DirCompare = BMIIDX12Glob.MusicWheelList[BMIIDX12Glob.PrevCWI]:GetY()
                end
            end
        end"
        UpdateThumbCommand="%function(self)
            local ScrollBarEle = SCREENMAN:GetTopScreen():GetChild('MusicWheel'):GetChild('')
            local EndDelta = 0
            local T1ZoomY = ScrollBarEle:GetChildAt(1):GetZoomY()
            local T2ZoomY = ScrollBarEle:GetChildAt(2):GetZoomY()
            local T1Y = ScrollBarEle:GetChildAt(1):GetY()
            local T2Y = ScrollBarEle:GetChildAt(2):GetY()
            
            if not BMIIDX12Glob.FirstTweening then
                self:finishtweening()
                self:decelerate(0.1)
            end
            if T2ZoomY >= T1ZoomY+0.01 then
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T1ZoomY/T2ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T2Y+EndDelta -15)
            else
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T2ZoomY/T1ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T1Y-EndDelta -15)
            end
            
            if not BMIIDX12Glob.FirstTweening then
                local ItemInd = BMIIDX12Glob.PrevCWI or CurWheelIndex()
                if BMIIDX12Glob.MusicWheelList[ItemInd] then
                    local NewDirCompare = BMIIDX12Glob.MusicWheelList[ItemInd]:GetY()
                    if BMIIDX12Glob.DirCompare and BMIIDX12Glob.DirCompare < NewDirCompare then
                        BMIIDX12Glob.DirCompare = nil
                        MESSAGEMAN:Broadcast('ScrollUp')
                    elseif BMIIDX12Glob.DirCompare and BMIIDX12Glob.DirCompare > NewDirCompare then
                        BMIIDX12Glob.DirCompare = nil
                        MESSAGEMAN:Broadcast('ScrollDown')
                    end
                end
            end
        end"
