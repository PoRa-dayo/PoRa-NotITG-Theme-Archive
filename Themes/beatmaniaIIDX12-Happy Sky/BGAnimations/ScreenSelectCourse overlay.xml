<ActorFrame
    OnCommand="queuecommand,UpdateScroll"
    CurrentSongChangedMessageCommand="%function(self)
        MESSAGEMAN:Broadcast('Update')
    end"
    CurrentStepsP1ChangedMessageCommand="%function(self)
        MESSAGEMAN:Broadcast('Update')
    end"
    CurrentStepsP2ChangedMessageCommand="%function(self)
        MESSAGEMAN:Broadcast('Update')
    end"
    UpdateScrollCommand="%function(self)
        if BMIIDX12Glob.ScrollUpdateNOW then return end
        BMIIDX12Glob.ScrollUpdateNOW=true
        self:queuecommand('Scroll')
    end"
    ScrollCommand="%function(self)
        if BMIIDX12Glob.ScrollUpdateNOW then
            MESSAGEMAN:Broadcast('UpdateScrollThumb')
            self:sleep(0.1)
            self:queuecommand('UpdateScroll')
            self:queuecommand('WheelSelect')
        end
        BMIIDX12Glob.ScrollUpdateNOW = false
    end"
    WheelSelectCommand="%function(self)
        UpdateWheelSelection()
    end"
    ><children>
    
    <Layer
        Type="Quad"
        OnCommand="%function(self)
            BMIIDX12Glob.MusicWheelList = {}
            BMIIDX12Glob.SelectedWheelItems = {}
            BMIIDX12Glob.FirstTweening=true
            BMIIDX12Glob.ScrollUpdateNOW = false
            BMIIDX12Glob.DirCompare=nil
            self:sleep(0.5)
            self:queuecommand('Disallow')
        end"
        DisallowCommand="%function(self)
            BMIIDX12Glob.FirstTweening=false
        end"
        CurrentSongChangedMessageCommand="%function(self)
            local ArtEle = BMIIDX12Glob.CourseArtist
            if ArtEle and (not BMIIDX12Glob.FirstTweening) then
                ArtEle:finishtweening()
                ArtEle:diffusealpha(0)
                ArtEle:addy(-8)
                
                ArtEle:sleep(0.3)
                ArtEle:linear(0.1)
                ArtEle:diffusealpha(1)
                ArtEle:addy(8)
            end
        end"/>
        
    #BPM DISPLAY
        
    <Layer
        File="bpm.png"
        Command="x,SCREEN_CENTER_X+(332-320);y,SCREEN_CENTER_Y+(135-240);hibernate,0.2;diffusealpha,0;decelerate,0.2;diffusealpha,1"
    />
        
    <Layer
        Type="BitmapText"
        Font="../Numbers/BPMDisplay bpm"
        Condition="FUCK_EXE"
        Text=""
        OnCommand="horizalign,right;x,SCREEN_CENTER_X+(360-320);y,SCREEN_CENTER_Y+(204-240);diffusealpha,0;sleep,0.2;decelerate,0.25;diffusealpha,1;shadowlength,1"
        OffCommand=""
        CurrentSongChangedMessageCommand="queuecommand,CourseUpdate"
        CourseUpdateCommand="%function(self) 
            local BPMDisplayEle = SCREENMAN:GetTopScreen():GetChild('BPMDisplay')
            if BPMDisplayEle then
                local BPMText = BPMDisplayEle:GetChild('Text'):GetText()
                local TargetInd = string.find(BPMText, '~', 1, true)
                local MinNum = TargetInd and string.sub(BPMText, 1, TargetInd - 1) or BPMText
                if (not tonumber(MinNum)) then
                    self:settext('--')
                else
                    self:settext(string.format('%03d', MinNum))
                end
            end
        end"/>
        
    <Layer
        Type="BitmapText"
        Font="../Numbers/BPMDisplay bpm"
        Condition="FUCK_EXE"
        Text=""
        OnCommand="horizalign,right;x,SCREEN_CENTER_X+(360-320);y,SCREEN_CENTER_Y+(224-240);diffusealpha,0;sleep,0.2;decelerate,0.25;diffusealpha,1;shadowlength,1"
        OffCommand=""
        CurrentSongChangedMessageCommand="queuecommand,CourseUpdate"
        CourseUpdateCommand="%function(self)
            local BPMDisplayEle = SCREENMAN:GetTopScreen():GetChild('BPMDisplay')
            if BPMDisplayEle then
                local BPMText = BPMDisplayEle:GetChild('Text'):GetText()
                local _, TargetInd = string.find(BPMText, '~', 1, true)
                local MaxNum = TargetInd and string.sub(BPMText, TargetInd + 1) or ''
                self:settext(MaxNum)
            end
            
        end"/>  
    
    <Layer
        Type="BitmapText"
        Font="songtitle"
        Text="Mirin Template"
        OnCommand="zoom,0.8;zoomx,0.7;maxwidth,410;draworder,33;x,SCREEN_CENTER_X-20;y,SCREEN_CENTER_Y-92;horizalign,right;shadowlength,0;addx,-170;linear,0.3;addx,170"
        OffCommand=""
        CurrentSongChangedMessageCommand="%function(self) 
            if not BMIIDX12Glob.FirstTweening then self:finishtweening() end
            self:queuecommand('UpdateTitle')
        end"
        UpdateTitleCommand="%function(self) 
            local course = GAMESTATE:GetCurrentCourse()
            if course then
                if not BMIIDX12Glob.FirstTweening then
                    self:diffusealpha(0.2)
                    self:addx(-170)
                end
                
                self:settext(course:GetDisplayFullTitle())
                
                if not BMIIDX12Glob.FirstTweening then
                    self:linear(0.3)
                    self:diffusealpha(1)
                    self:addx(170)
                end
            else
                self:settext('')
            end
        end"/>
        
    <Layer
        File="ScreenSelectCourse banner frame"
        OnCommand="zoom,0.62;x,SCREEN_CENTER_X+(260-320);y,SCREEN_CENTER_Y+(209-240);hibernate,0.2;diffusealpha,0;decelerate,0.2;diffusealpha,1"
    />
    
    
    
    #the shiny animation whenever the course changes
    
    <Layer
        File="flash.png"
        Command="zoomy,2;x,SCREEN_CENTER_X-15;y,SCREEN_CENTER_Y-90;blend,add;diffusealpha,0;"
        CurrentSongChangedMessageCommand="finishtweening;diffusealpha,0;zoomx,5;sleep,0.25;linear,0.1;diffusealpha,0.8;linear,0.5;zoomx,1;diffusealpha,0"
    />
    
    <Layer
        File="ScreenTitleMenu background/pop"
        Command="x,SCREEN_CENTER_X-20;y,SCREEN_CENTER_Y-90;diffusealpha,0"
        CurrentSongChangedMessageCommand="finishtweening;diffusealpha,0;x,SCREEN_CENTER_X+(300-320);rotationz,0;zoomx,1;sleep,0.25;diffusealpha,1;linear,1;rotationz,540;x,SCREEN_CENTER_X+(400-320);zoomx,0.6;diffusealpha,0"
    />
    
    <Layer
        File="ScreenTitleMenu background/ring.png"
        Command="x,SCREEN_CENTER_X-20;y,SCREEN_CENTER_Y-90;diffusealpha,0;blend,add"
        CurrentSongChangedMessageCommand="finishtweening;diffusealpha,0;zoom,0;sleep,0.25;linear,0.1;diffusealpha,1;zoomy,0.4;zoomx,0.5;linear,0.7;zoomy,0.6;zoomx,0.7;diffusealpha,0"
    />
    
    
    <Layer
        File="ScrollBar parts"
        Condition="FUCK_EXE"
        OnCommand="%function(self)
            self:animate(0)
            self:setstate(0)
            self:x(SCREEN_WIDTH-98+102-25)
            self:y(SCREEN_CENTER_Y-200/2-self:GetHeight()/2 -15)
            
            self:zoomy(0)
            self:sleep(0.2)
            self:decelerate(0.5)
            self:zoomy(1)
        end"
    />
    <Layer
        File="ScrollBar parts"
        Condition="FUCK_EXE"
        OnCommand="%function(self)
            self:animate(0)
            self:setstate(1)
            self:vertalign('top')
            self:x(SCREEN_WIDTH-98+102-25)
            self:y(SCREEN_CENTER_Y-200/2-self:GetHeight()/2 -15)
            self:zoomtoheight(0)
            
            self:sleep(0.2)
            self:decelerate(0.5)
            self:y(SCREEN_CENTER_Y-200/2 -15)
            self:zoomtoheight(200)
        end"
    />
    <Layer
        File="ScrollBar parts"
        Condition="FUCK_EXE"
        OnCommand="%function(self)
            self:animate(0)
            self:setstate(2)
            self:x(SCREEN_WIDTH-98+102-25)
            self:y(SCREEN_CENTER_Y-200/2-self:GetHeight()/2 -15)
            self:zoomy(0)
            
            self:sleep(0.2)
            self:decelerate(0.5)
            self:y(SCREEN_CENTER_Y+200/2+self:GetHeight()/2 -15)
            self:zoomy(1)
        end"
    />
    <Layer
        Type="ActorFrame"
        Condition="FUCK_EXE"
        OnCommand="x,SCREEN_WIDTH-98+102-25-1;y,SCREEN_CENTER_Y-15"
        UpdateScrollThumbMessageCommand="queuecommand,UpdateThumb"
        CurrentSongChangedMessageCommand="%function(self)
            if not BMIIDX12Glob.FirstTweening then
                BMIIDX12Glob.PrevCWI = CurWheelIndex()
                if BMIIDX12Glob.MusicWheelList[BMIIDX12Glob.PrevCWI] then
                    BMIIDX12Glob.DirCompare = BMIIDX12Glob.MusicWheelList[BMIIDX12Glob.PrevCWI]:GetY()
                end
            end
        end"
        UpdateThumbCommand="%function(self)
            local ScrollBarEle = SCREENMAN:GetTopScreen():GetChild('MusicWheel'):GetChild('')
            local EndDelta = 0
            local T1ZoomY = ScrollBarEle:GetChildAt(1):GetZoomY()
            local T2ZoomY = ScrollBarEle:GetChildAt(2):GetZoomY()
            local T1Y = ScrollBarEle:GetChildAt(1):GetY()
            local T2Y = ScrollBarEle:GetChildAt(2):GetY()
            
            if not BMIIDX12Glob.FirstTweening then
                self:finishtweening()
                self:decelerate(0.1)
            end
            if T2ZoomY >= T1ZoomY+0.01 then
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T1ZoomY/T2ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T2Y+EndDelta -15)
            else
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T2ZoomY/T1ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T1Y-EndDelta -15)
            end
            
            if not BMIIDX12Glob.FirstTweening then
                local ItemInd = BMIIDX12Glob.PrevCWI or CurWheelIndex()
                if BMIIDX12Glob.MusicWheelList[ItemInd] then
                    local NewDirCompare = BMIIDX12Glob.MusicWheelList[ItemInd]:GetY()
                    if BMIIDX12Glob.DirCompare and BMIIDX12Glob.DirCompare < NewDirCompare then
                        BMIIDX12Glob.DirCompare = nil
                        MESSAGEMAN:Broadcast('ScrollUp')
                    elseif BMIIDX12Glob.DirCompare and BMIIDX12Glob.DirCompare > NewDirCompare then
                        BMIIDX12Glob.DirCompare = nil
                        MESSAGEMAN:Broadcast('ScrollDown')
                    end
                end
            end
        end"
    ><children>
        <Layer
            File="ScrollBar thumb"
            OnCommand="%function(self)
                self:blend('add')
                self:diffuse(0,0,0,0)
                self:sleep(0.4)
                self:linear(0.2)
                self:diffuse(1,1,1,1)
            end"
        />
        <Layer
            File="ScrollBar thumb"
            OnCommand="%function(self)
                self:blend('add')
                self:diffuseramp()
                self:effectcolor1(1,1,1,0)
                self:effectcolor2(1,1,1,0.3)
                
                self:diffuse(0,0,0,0)
                self:sleep(0.4)
                self:linear(0.2)
                self:diffuse(1,1,1,1)
            end"
        />
    </children></Layer>
    <Layer
        File="ScreenSelectMusic menu left"
        OnCommand="%function(self)
            self:blend('add')
            self:x(SCREEN_WIDTH-98+102-25)
            self:y(SCREEN_CENTER_Y-200/2-self:GetHeight()/2+5 -15)
            self:diffusealpha(0)
        end"
        ScrollUpMessageCommand="%function(self)
            self:finishtweening()
            self:diffusealpha(1)
            self:linear(0.2)
            self:diffusealpha(0)
        end"
    />
    <Layer
        File="ScreenSelectMusic menu right"
        OnCommand="%function(self)
            self:blend('add')
            self:x(SCREEN_WIDTH-98+102-25)
            self:y(SCREEN_CENTER_Y+200/2+self:GetHeight()/2-5 -15)
            self:diffusealpha(0)
        end"
        ScrollDownMessageCommand="%function(self)
            self:finishtweening()
            self:diffusealpha(1)
            self:linear(0.2)
            self:diffusealpha(0)
        end"
    />
</children></ActorFrame>