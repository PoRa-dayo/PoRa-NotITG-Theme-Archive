<ActorFrame
    Condition="FUCK_EXE"
    ><children>
    
    //PLAYER 1
    <Layer
        File="../../meter stream"
        OnCommand="draworder,-1;diffusealpha,0"
        LoadToastyP1MessageCommand="%function(self)
            self:stoptweening()
            self:diffusealpha(0)
            self:Load(THEME:GetPath(EC_BGANIMATIONS, '', 'toasty/' .. string.lower(BMIIDX12Glob.TempToasty) .. '/toastyP1_bg_static.png'))
            self:queuecommand('ToastyP1')
        end"
        ToastyP1Command="x,SCREEN_CENTER_X-159;y,SCREEN_CENTER_Y;diffusealpha,0;linear,0.166;diffusealpha,1;sleep,1;linear,0.166;diffusealpha,0"/>
        
    <Layer
        File="../../meter stream"
        OnCommand="draworder,-1;diffusealpha,0;blend,add;"
        LoadToastyP1MessageCommand="%function(self)
            self:stoptweening()
            self:diffusealpha(0)
            self:Load(THEME:GetPath(EC_BGANIMATIONS, '', 'toasty/' .. string.lower(BMIIDX12Glob.TempToasty) .. '/toastyP1_bg.png'))
            self:queuecommand('ToastyP1')
