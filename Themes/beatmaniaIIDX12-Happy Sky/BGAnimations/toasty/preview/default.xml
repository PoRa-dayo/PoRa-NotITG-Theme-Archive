                self:Load(THEME:GetPath(EC_BGANIMATIONS, '', 'toasty/michael a la mode/toastyP1.sprite'))
            else
                self:Load(THEME:GetPath(EC_BGANIMATIONS, '', 'toasty/' .. string.lower(BMIIDX12Glob.TempToasty) .. '/toastyP1.png'))
            end
            self:queuecommand('ToastyP1')
        end"
        ToastyP1Command="setstate,0;animate,1;x,SCREEN_CENTER_X-159;y,SCREEN_CENTER_Y+(364-240);addy,-120;diffusealpha,0;sleep,0.066;linear,0.1;addy,-4;diffusealpha,1;linear,1;addy,-10;linear,0.1;addy,-4;diffusealpha,0"/>
               
