<ActorFrame><children>
    <Layer
        File="failed.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomx,1.2;fadeleft,0.2;faderight,0.2"
        Condition="GetBestGrade() >= Grade('D')"
    />
    
    <Layer
        File="failed.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoom,3;linear,0.3;zoom,1"
        Condition="GetBestGrade() >= Grade('D')"
    />

    <Layer
        File="failed.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoom,3;diffusealpha,0.5;sleep,0.03;linear,0.3;zoom,1;linear,0.1;diffusealpha,0"
        Condition="GetBestGrade() >= Grade('D')"
    />

    <Layer
        File="failed.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoom,3;diffusealpha,0.5;sleep,0.06;linear,0.3;zoom,1;linear,0.1;diffusealpha,0"
        Condition="GetBestGrade() >= Grade('D')"
    />

    <Layer
        File="failed.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;blend,add;zoom,3;linear,0.3;zoom,1;linear,0.1;diffusealpha,0"
        Condition="GetBestGrade() >= Grade('D')"
    />

    <Layer
        File="down.png"
        Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y+(-640-240);blend,add;linear,1;y,SCREEN_CENTER_Y+(1200-240)"
        Condition="GetBestGrade() >= Grade('D')"
    />

