        <Layer
            Text="Event"
            Font="_mdgaesung 20px"
            InitCommand="y,SCREEN_TOP+10;x,SCREEN_CENTER_X;zoomx,0.8;shadowlength,0"
            OnCommand="queuecommand,Update"
            CurrentStepsP1ChangedMessageCommand="playcommand,Update"
            CurrentStepsP2ChangedMessageCommand="playcommand,Update"
            CurrentSongChangedMessageCommand="playcommand,Update"
            UpdateCommand="%function(self)
                if GAMESTATE:IsCourseMode() then
                    local songind = GAMESTATE:GetCourseSongIndex()
                    if songind then
                        self:settext('Song ' .. songind+1)
                    else
                        self:settext('Course')
                    end
                elseif not GAMESTATE:IsEventMode() then
                    if IsExtraStage() or IsExtraStage2() then
                        self:settext('Stage Extra')
                    elseif IsFinalStage() then
                        self:settext('Stage Final')
                    else
                        self:settext('Stage ' .. GAMESTATE:StageIndex()+1)
                    end
                end
            end"
        />
        <Layer
            Text="00.0"
            Font="../Numbers/_xenotron metal"
            OnCommand="y,SCREEN_TOP+32;x,SCREEN_CENTER_X;shadowlength,0;queuecommand,Update"
            CurrentSongChangedMessageCommand="queuecommand,Update"
            UpdateCommand="%function(self)
                local timeintimer = self:GetSecsIntoEffect();
                self:effectclock('music')
                if GAMESTATE:GetCurrentSong() then
                    local totaltimer = GAMESTATE:GetCurrentSong():StepsLengthSeconds()
                    if timeintimer >= totaltimer then
                        self:settext('00.0')
                    else
                        self:settext(string.format('%04.1f', totaltimer-timeintimer))
                        self:sleep(0.1)
                        self:queuecommand('Update')
                    end
                end
            end"
        />
        
