        <Layer
            File="../Gameplay/1PlifeGageB"
            Condition="FUCK_EXE"
            OnCommand="y,SCREEN_TOP+52;x,SCREEN_CENTER_X+193"
        />
        --when HP drops, the lifebarA (red) will wait for a while, storing the HP it's supposed to go to in NextLX
        --while waiting it'll start counting ShowLostLXTimes every update, when it reaches 30, lifebarA will drop
        --if HP drops again while waiting (LX smaller than NextLX), reset ShowLostHealthTimes
        <Layer
            File="../Gameplay/1PlifeBarA"
            Condition="FUCK_EXE"
            InitCommand="%function(self)
                ToHoSokuGlob.CurL1 = nil
            end"
            OnCommand="y,SCREEN_TOP+32.5;x,SCREEN_CENTER_X-184;queuecommand,Update"
            UpdateCommand="%function(self)
                if not GAMESTATE:IsPlayerEnabled(PLAYER_1) then return end
                local L1 = SCREENMAN:GetTopScreen():GetLife(PLAYER_1)
                if not ToHoSokuGlob.CurL1 then
                    self:cropleft(1-L1)
                    self:sleep(0.05)
                    ToHoSokuGlob.CurL1 = L1
                    ToHoSokuGlob.NextL1 = L1
                    ToHoSokuGlob.ShowLostL1Times = 30
                elseif L1 > ToHoSokuGlob.CurL1 then
                    self:cropleft(1-L1)
                    ToHoSokuGlob.CurL1 = L1
                    ToHoSokuGlob.NextL1 = L1
                    ToHoSokuGlob.ShowLostL1Times = 30
                    self:sleep(0.05)
                elseif ToHoSokuGlob.NextL1 and L1 < ToHoSokuGlob.NextL1 then
                    ToHoSokuGlob.NextL1 = L1
                    ToHoSokuGlob.ShowLostL1Times = 0
                    self:sleep(0.05)
                else
                    ToHoSokuGlob.ShowLostL1Times = (ToHoSokuGlob.ShowLostL1Times or 0) + 1
                    if ToHoSokuGlob.ShowLostL1Times > 30 then
                        ToHoSokuGlob.ShowLostL1Times = 0
                        self:linear(0.2)
                        self:cropleft(1-L1)
                        ToHoSokuGlob.CurL1 = L1
                        ToHoSokuGlob.NextL1 = nil
                    else
                        ToHoSokuGlob.NextL1 = L1
                        self:sleep(0.05)
                    end
                end
                self:queuecommand('Update')
            end"
        />
        <Layer
            File="../Gameplay/1PlifeBarB"
