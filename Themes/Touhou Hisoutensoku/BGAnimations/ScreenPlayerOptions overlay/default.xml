<ActorFrame> <children>
    <Layer
       File="../Config/Config"
       InitCommand="x,SCREEN_CENTER_X-198;y,SCREEN_CENTER_Y-192"
    />
    <Layer
       File="../_black"
       Condition="ToHoSokuGlob.OptionsScreen ~= 'SongOptions'"
       InitCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomto,SCREEN_WIDTH,SCREEN_HEIGHT;diffusealpha,1;linear,0.5;diffusealpha,0"
    />
	<Layer
		Type="Quad"
		OnCommand="%function(self)
            ToHoSokuGlob.OptionsScreen = 'PlayerOptions'
            self:queuecommand('StartCapture')
        end"
        StartCaptureCommand="%function(self)
            CaptureOptionRows()
            self:sleep(0.05)
            self:queuecommand('PostCapture')
        end"
        PostCaptureCommand="%function(self)
            PostModCaptureInit()
        end"
        OffCommand="%function(self)
            --otherwise if anything tries to access these, it will cause AV because the elements are no longer there
            ClearOptionCaptures()
            
            ToHoSokuGlob.OptionsScreen = nil
        end"
	/>
</children> </ActorFrame>

