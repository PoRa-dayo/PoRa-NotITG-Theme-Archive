<ActorFrame> <children>
        <Layer
           File="../Config/Result"
           InitCommand="x,SCREEN_CENTER_X-198;y,SCREEN_CENTER_Y-192"
        />
        
        <Layer 
            Text=""
            Font="_aldine721 bt-black 40px"
            OnCommand="%function(self)
                self:x(SCREEN_CENTER_X)
                self:y(SCREEN_CENTER_Y-160)
                self:zoom(0.4)
                SongTitle(self)
            end"
        />
        
        <Layer 
            Text=""
            Font="_aldine721 bt-black 20px"
            OnCommand="%function(self)
                self:x(SCREEN_CENTER_X)
                self:y(SCREEN_CENTER_Y-65)
                self:zoom(0.6)
                if GAMESTATE:IsCourseMode() then
                    RateModText(self)
                else
                    BPMlabelRate(self)
                end
            end"
        />
        
        <!-- P1 Labels -->
        <Layer 
            Text=""
            Font="_aldine721 bt-black 20px"
            Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
            OnCommand="horizalign,left;zoom,0.7;shadowlength,0;x,SCREEN_CENTER_X-280+EvalX();y,SCREEN_CENTER_Y-70;queuecommand,DiffUpdate"
            DiffUpdateCommand="%function(self)
                local stepp = GAMESTATE:GetCurrentSteps(PLAYER_1)
                if stepp then
                    self:settext(DifficultyToThemedString(stepp:GetDifficulty())..' '..stepp:GetMeter())
                else
                    self:settext('')
                end
           end"
        />
