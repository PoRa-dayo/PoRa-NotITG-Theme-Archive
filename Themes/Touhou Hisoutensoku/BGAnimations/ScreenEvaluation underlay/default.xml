<ActorFrame
><children>
    <Layer
        InitCommand="%function(self)
            self:hidden(1)
            Sound('061')
            MESSAGEMAN:Broadcast('ShowWideOverlay')
        end"
    />
    <Layer
       File="../_Gears/door_l"
       InitCommand="diffuse,0.5,0.5,0.5,1;y,SCREEN_CENTER_Y;x,SCREEN_CENTER_X-480;decelerate,0.3;x,SCREEN_CENTER_X-80"
    />
    <Layer
       File="../_Gears/door_r"
       InitCommand="diffuse,0.5,0.5,0.5,1;y,SCREEN_CENTER_Y;x,SCREEN_CENTER_X+480;decelerate,0.3;x,SCREEN_CENTER_X+80"
    />
    <Layer
       File="../_GearTop"
       InitCommand="y,-320;decelerate,0.3;y,-192"
    />
    <Layer
       File="../_GearBottom"
       InitCommand="y,320;decelerate,0.3;y,208"
    />
    
    <!-- Default Banner -->
    <Layer
       File="../MusicWheel/17"
       InitCommand="zoomto,184,72;x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-108"
    />
    <Layer
       Text="No Banner"
       Font="_aldine721 bt-black 20px"
       InitCommand="zoom,0.8;x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-108;diffuse,1,1,1,0.5"
    />
</children></ActorFrame>
