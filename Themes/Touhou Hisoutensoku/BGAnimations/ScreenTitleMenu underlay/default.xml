<ActorFrame
    OnCommand="%function(self)
        if ToHoSokuGlob.FromOption ~= 1 then
            MESSAGEMAN:Broadcast('StartNormal')
        else
            MESSAGEMAN:Broadcast('StartOption')
            ToHoSokuGlob.FromOption = 0
        end
        ToHoSokuGlob.ScrollStart = 0
        ToHoSokuGlob.FromScreenEdit = 0
        self:sleep(0.66)
        self:queuecommand('Start')
    end"
    StartCommand="%function(self)
        ToHoSokuGlob.ScrollStart = 1
    end"
    UpdateGearMessageCommand="%function(self)
        if ToHoSokuGlob.ScrollerPos and (ToHoSokuGlob.ScrollerPos == ToHoSokuGlob.ScrollerCheck) then
            if ToHoSokuGlob.ScrollStart == 1 then
                self:GetChild('Gear'):finishtweening();
                self:GetChild('GearShad'):finishtweening();
                self:GetChild('ScrollerArm'):finishtweening();
            end;
            self:GetChild('Gear'):decelerate(0.25);
            self:GetChild('Gear'):rotationz(ToHoSokuGlob.ScrollerPos*29);
            self:GetChild('Gear'):y((SCREEN_CENTER_Y-180)+(ToHoSokuGlob.ScrollerPos*23.8));
            self:GetChild('GearShad'):decelerate(0.25);
            self:GetChild('GearShad'):rotationz(ToHoSokuGlob.ScrollerPos*29);
            self:GetChild('GearShad'):y((SCREEN_CENTER_Y-176)+(ToHoSokuGlob.ScrollerPos*23.8));
            self:GetChild('ScrollerArm'):decelerate(0.25);
            self:GetChild('ScrollerArm'):y((SCREEN_CENTER_Y-164)+(ToHoSokuGlob.ScrollerPos*24));		
            ToHoSokuGlob.ScrollerCheck = 999;
        end;
    end"
