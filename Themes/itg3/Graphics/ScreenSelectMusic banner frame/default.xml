<!-- P1 Stepartist -->
<ActorFrame
		InitCommand="x,SCREEN_LEFT;y,SCREEN_BOTTOM-109;addx,-SCREEN_WIDTH;decelerate,0.75;addx,SCREEN_WIDTH;"
		OffCommand="accelerate,0.75;addx,-SCREEN_WIDTH"
        OnCommand="%function(self)
            if not PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
                self:sleep(0.1)
                self:y(SCREEN_BOTTOM-127)
            end
        end"
		SelectMenuOffMessageCommand="%function(self)
            if PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
                self:stoptweening()
                self:decelerate(.3)
                self:y(SCREEN_BOTTOM-109)
            else
                StepartistHiddenPress(self)
            end
        end"
		SelectMenuOnMessageCommand="%function(self)
            if not PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
                self:stoptweening()
                self:decelerate(.3)
                self:y(SCREEN_BOTTOM-109)
            else
                StepartistHiddenPress(self)
            end
        end"
		CurrentStepsP1ChangedMessageCommand="%StepartistHiddenSort"
		Condition="GAMESTATE:IsHumanPlayer(PLAYER_1)">
