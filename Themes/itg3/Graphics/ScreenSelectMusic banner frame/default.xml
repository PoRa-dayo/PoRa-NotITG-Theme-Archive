<!--Song Length Popup -->


<Layer 
    File="../_pane elements/_length"
    Condition="OPENITG and not GAMESTATE:IsCourseMode()"
    InitCommand="diffusealpha,0;ztest,1;zoom,.6;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-34;vertalign,bottom"
    OnCommand="addx,500;decelerate,0.5;addx,-500"
    OffCommand="linear,0.2;diffusealpha,0"
    EnableSelectHelpMessageCommand="%function(self)
        if not GAMESTATE:GetCurrentSong() then
            self:queuecommand('SelectMenuOffMessage')
        else
            self:stoptweening()
            self:linear(0.2)
            if PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
                self:diffusealpha(1)
            else
                self:diffusealpha(0)
            end
        end
    end"
    SelectMenuOffMessageCommand="%function(self)
        self:stoptweening()
        self:linear(0.2)
        if PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
            self:diffusealpha(0)
        elseif GAMESTATE:GetCurrentSong() then
            self:diffusealpha(1)
        end
    end"
    CurrentSongChangedMessageCommand="%function(self)
        if not GAMESTATE:GetCurrentSong() then
            self:stoptweening()
            self:linear(0.2)
            self:diffusealpha(0)
        elseif not PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
            self:stoptweening()
            self:linear(0.2)
            self:diffusealpha(1)
        end
    end"
/>		
<Layer Type="BitmapText"
    Font="_v 26px bold diffuse"
    Text="HELLO"
    Condition="OPENITG and not GAMESTATE:IsCourseMode()"
    InitCommand="diffusealpha,0;shadowlength,0.5;horizalign,left;zoom,.6;x,SCREEN_CENTER_X-14;y,SCREEN_CENTER_Y-44"
    OnCommand="%function(self)
        self:addx(SCREEN_WIDTH)
        self:decelerate(0.75)
        self:addx(-SCREEN_WIDTH)
        if not PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
            self:linear(0.2)
            self:diffusealpha(1)
        end
    end"
    CurrentSongChangedMessageCommand="playcommand,Set"
    SetCommand="%function(self)
        local song = GAMESTATE:GetCurrentSong()
        if not song then self:hidden(1) return end
        self:settext( GetSongLength() )
        self:hidden(0)
    end"
    EnableSelectHelpMessageCommand="%function(self)
        self:stoptweening()
        self:linear(0.2)
        if PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
            self:diffusealpha(1)
        else
            self:diffusealpha(0)
        end
    end"
    SelectMenuOffMessageCommand="%function(self)
        self:stoptweening()
        self:linear(0.2)
        if PROFILEMAN:GetMachineProfile():GetSaved().ITG3HideSongDetails then
            self:diffusealpha(0)
        else
            self:diffusealpha(1)
        end
    end"
    OffCommand="linear,.12;diffusealpha,0;"
/>
