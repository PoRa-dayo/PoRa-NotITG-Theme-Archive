        Condition="IsPlayerEnabled(1) and GAMESTATE:IsHumanPlayer(PLAYER_1) and CurStyleName()~='double'"
        ToastyP1MessageCommand="setstate,0;animate,1;x,SCREEN_CENTER_X+ToastP1AddX;y,SCREEN_CENTER_Y+(364-240);addy,-120;diffusealpha,0;sleep,0.066;linear,0.1;addy,-4;diffusealpha,1;linear,1;addy,-10;linear,0.1;addy,-4;diffusealpha,0"/>
               
