        OnCommand="draworder,-1;diffusealpha,0;blend,add;"
        Condition="IsPlayerEnabled(1) and GAMESTATE:IsHumanPlayer(PLAYER_1) and CurStyleName()~='double'"
        ToastyP1MessageCommand="addx,0;x,SCREEN_CENTER_X+(292-320)+ToastP1AddX;y,SCREEN_CENTER_Y;cropleft,0.24;cropright,0;diffusealpha,0;sleep,0.066;linear,0.1;diffusealpha,0.8;linear,0.668;addx,56;cropleft,0;cropright,0.24;linear,0.1;diffusealpha,0"/>
        
    <Layer
