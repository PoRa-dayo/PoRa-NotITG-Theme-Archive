<ActorFrame
    CurrentSongChangedMessageCommand="queuecommand,SendUpdate"
    CurrentStepsP1ChangedMessageCommand="queuecommand,SendUpdate"
    CurrentStepsP2ChangedMessageCommand="queuecommand,SendUpdate"
    SendUpdateCommand="%function(self)
    MESSAGEMAN:Broadcast('Update')
    end"
    ><children>
    <Layer
        File="ScreenSelectMusic score frame p1"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="x,SCREEN_CENTER_X+(114-320);y,SCREEN_CENTER_Y+(455-240)"/>
        
    <Layer
        File="ScreenSelectMusic score frame p1"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_2)"
        OnCommand="x,SCREEN_CENTER_X+(529-320);y,SCREEN_CENTER_Y+(455-240)"/>
        
    <Layer
        Type="BitmapText"
        Font="artist 16px"
        Text="Subtitle"
        Condition="not GAMESTATE:IsCourseMode()"
        OnCommand="zoom,0.6;draworder,32;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-100;horizalign,right;shadowlength,0;maxwidth,300;addx,480;decelerate,0.3;addx,-480;maxwidth,550"
        OffCommand=""
        UpdateMessageCommand="%function(self) 
            local song = GAMESTATE:GetCurrentSong()
            if song then
                self:settext(song:GetDisplaySubTitle())
            else
                self:settext('')
            end
        end" />
    <Layer
        Type="BitmapText"
        Font="songtitle 16px"
        Text="Mirin Template"
        OnCommand="zoom,0.8;zoomx,0.7;draworder,33;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-80;horizalign,right;shadowlength,0;maxwidth,300;addx,480;decelerate,0.3;addx,-480;maxwidth,460"
        OffCommand=""
        UpdateMessageCommand="%function(self) 
            local song = GAMESTATE:GetCurrentSong()
            local course = GAMESTATE:GetCurrentCourse()
            if song then
                self:settext(song:GetDisplayMainTitle())
            elseif course then
                self:settext(course:GetDisplayFullTitle())
            else
                self:settext('')
            end
        end" />
    <Layer
        Type="BitmapText"
        Font="OptionIcon"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="draworder,102;x,SCREEN_CENTER_X+(115-320)-100;y,SCREEN_CENTER_Y+(398-240)+14;horizalign,left;shadowlength,0;maxwidth,160;zoom,1.2"
        OffCommand=""
        UpdateMessageCommand="%function(self) self:settext(GetStepsDescriptionText(PLAYER_1)) end" />
    <Layer
        Type="BitmapText"
        Font="OptionIcon"
        Text=""
        Condition="not GAMESTATE:IsCourseMode() and GAMESTATE:IsPlayerEnabled(PLAYER_2)"
        OnCommand="draworder,102;x,SCREEN_CENTER_X+(531-320)-100;y,SCREEN_CENTER_Y+(398-240)+14;horizalign,left;shadowlength,0;maxwidth,160;zoom,1.2"
        OffCommand=""
        UpdateMessageCommand="%function(self) self:settext(GetStepsDescriptionText(PLAYER_2)) end" />
</children></ActorFrame>