<ActorFrame><children>
    --TOASTY (if Profile().IIDXGoldToasty and/or Profile().IIDXGoldToastyP2 is nil then ScreenStage in will change it to Michael a la mode
    <Layer File="toasty" OnCommand="%function(self)
        DeltaToastyMilestone = 100
        P1ToastyMilestone = DeltaToastyMilestone
        P2ToastyMilestone = DeltaToastyMilestone
        
        ToastP1AddX = -159
        ToastP2AddX = 159
        if GAMESTATE:IsHumanPlayer(PLAYER_1) and CurStyleName()=='single' then
            ToastP1AddX = 159
        end
        if GAMESTATE:IsHumanPlayer(PLAYER_2) and CurStyleName()=='single' then
            ToastP2AddX = -159
        end
    end"
    />
    
    <Layer File="ScreenGameplayNormalP1 score frame" Condition="GAMESTATE:IsPlayerEnabled(0) and CurStyleName() ~= 'double'" OnCommand="%function(self)
        self:x(SCREEN_CENTER_X)
        self:y(SCREEN_CENTER_Y)
        self:addx(-300)
        self:linear(0.25)
        self:addx(300)
        if Profile().IIDXGoldScreenFilter then
            self:diffusealpha(tonumber(Profile().IIDXGoldScreenFilter))
        else
            self:diffusealpha(0.3)
        end
    end"/>
    <Layer File="ScreenGameplayNormalP2 score frame" Condition="GAMESTATE:IsPlayerEnabled(1) and CurStyleName() ~= 'double'" OnCommand="%function(self)
        self:x(SCREEN_CENTER_X)
        self:y(SCREEN_CENTER_Y)
        self:addx(300)
        self:linear(0.25)
        self:addx(-300)
        if Profile().IIDXGoldScreenFilter then
            self:diffusealpha(tonumber(Profile().IIDXGoldScreenFilter))
        else
            self:diffusealpha(0.3)
        end
    end"/>
    <Layer File="ScreenGameplayNormalDouble score frame" Condition="CurStyleName() == 'double'" OnCommand="%function(self)
        self:x(SCREEN_CENTER_X)
        self:y(SCREEN_CENTER_Y)
        self:addx(-300)
        self:linear(0.25)
        self:addx(300)
        if Profile().IIDXGoldScreenFilter then
            self:diffusealpha(tonumber(Profile().IIDXGoldScreenFilter))
        else
            self:diffusealpha(0.3)
        end
    end"/>

    <Layer File="../Graphics/frame/dance/troopers/Versus" Condition="GAMESTATE:IsPlayerEnabled(1) and GAMESTATE:IsPlayerEnabled(0) and PlayModeName() ~= 'Rave'"/>
    <Layer File="../Graphics/frame/dance/troopers/P1_Dance" Condition="GAMESTATE:IsPlayerEnabled(0) and not GAMESTATE:IsPlayerEnabled(1) and PlayModeName() ~= 'Rave' and PlayModeName() ~= 'Oni'"/>
    <Layer File="../Graphics/frame/dance/troopers/P2_Dance" Condition="GAMESTATE:IsPlayerEnabled(1) and not GAMESTATE:IsPlayerEnabled(0) and PlayModeName() ~= 'Rave' and PlayModeName() ~= 'Oni'"/>
    <Layer File="../Graphics/frame/dance/troopers/P1_Oni" Condition="GAMESTATE:IsPlayerEnabled(0) and not GAMESTATE:IsPlayerEnabled(1) and PlayModeName() == 'Oni'"/>
    <Layer File="../Graphics/frame/dance/troopers/P2_Oni" Condition="GAMESTATE:IsPlayerEnabled(1) and not GAMESTATE:IsPlayerEnabled(0) and PlayModeName() == 'Oni'"/>
    <Layer File="../Graphics/frame/dance/troopers/Rave" Condition="PlayModeName() == 'Rave'"/>
    
    <ActorFrame
		OnCommand="%function(self)
			self:stopeffect()
			if FUCK_EXE then
				stitch('lua.death').Start()
			end
		end" 
	/>
</children></ActorFrame>
