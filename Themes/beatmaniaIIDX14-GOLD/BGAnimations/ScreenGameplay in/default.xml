<ActorFrame><children>
    <!-- This will load another command with an existing animation. -->
	<Layer File="../frame/dance/troopers/P1_Dance" Condition="GAMESTATE:IsPlayerEnabled(0) and not GAMESTATE:IsPlayerEnabled(1) and PlayModeName() ~= 'Rave'"/>
    <Layer File="../frame/dance/troopers/P2_Dance" Condition="GAMESTATE:IsPlayerEnabled(1) and not GAMESTATE:IsPlayerEnabled(0) and PlayModeName() ~= 'Rave'"/>
    <Layer File="../frame/dance/troopers/Versus" Condition="GAMESTATE:IsPlayerEnabled(1) and GAMESTATE:IsPlayerEnabled(0) and PlayModeName() ~= 'Rave'"/>
    <Layer File="../frame/dance/troopers/Rave" Condition="PlayModeName() == 'Rave'"/>
    
    <Layer File="ready.png" OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;addy,-50;diffusealpha,0;sleep,3.5;decelerate,0.4;addy,50;diffusealpha,1;sleep,0.4;decelerate,0.2;diffusealpha,0"/>
    <Layer File="ready.png" OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;blend,add;diffusealpha,0;sleep,4.3;diffusealpha,1;decelerate,0.4;zoomy,1;zoomx,2;diffusealpha,0"/>
    <Layer File="ready.png" OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;blend,add;diffusealpha,0;sleep,4.3;diffusealpha,1;decelerate,0.4;zoomy,0.5;zoomx,3;diffusealpha,0"/>
    <Layer File="ready blend.png" OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;blend,add;diffusealpha,0;sleep,4.3;diffusealpha,1;decelerate,0.4;zoom,1.5;diffusealpha,0"/>
</children></ActorFrame>