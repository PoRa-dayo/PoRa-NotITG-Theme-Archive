<ActorFrame>
		<children>
	<Layer
		Class="AutoActor" 
		File="../ScreenWithMenuElements underlay/_base"
	/>
		<Layer
		Class="AutoActor" 
		File="../ScreenWithMenuElements underlay/_sides"
	/>
	<Layer 
		Class="ActorFrame" 
		InitCommand="x,SCREEN_CENTER_X+100;y,SCREEN_CENTER_Y+13;z,-100;zoom,1.3"
	>
		<children>
			<ActorFrame>
					<children>
                                <AutoActor 
                                    File="char" 
                                    Condition="ITG3IsOriginal()"
                                    OnCommand="zoom,0.6;zbuffer,1;glow,1,1,1,0;diffusealpha,0;linear,0.3;glow,1,1,1,1;sleep,0.001;diffusealpha,1;linear,0.3;glow,1,1,1,0" 
                                    OffCommand=""
                                    MadeChoiceP1MessageCommand="playcommand,GoOff"
                                    MadeChoiceP2MessageCommand="playcommand,GoOff"
                                    GoOffCommand="sleep,.2;linear,0.3;diffusealpha,0;"							/>
                                    
                                <AutoActor 
                                    File="char_encore"
                                    Condition="not ITG3IsOriginal()"                                    
                                    OnCommand="zoom,0.6;zbuffer,1;glow,1,1,1,0;diffusealpha,0;linear,0.3;glow,1,1,1,1;sleep,0.001;diffusealpha,1;linear,0.3;glow,1,1,1,0" 
                                    OffCommand=""
                                    MadeChoiceP1MessageCommand="playcommand,GoOff"
                                    MadeChoiceP2MessageCommand="playcommand,GoOff"
                                    GoOffCommand="sleep,.2;linear,0.3;diffusealpha,0;"							/>
					</children>
			</ActorFrame>
		</children>
</Layer>

    <Layer Class="AutoActor" 
		File="../ScreenSelectPlayMode underlay/explanation frame" 
        Condition="ITG3IsOriginal()"
		OnCommand="horizalign,center;x,SCREEN_CENTER_X+100;y,SCREEN_CENTER_Y+138;diffusealpha,0;linear,0.5;diffusealpha,0.8" 
		MadeChoiceP1MessageCommand="playcommand,GoOff"
		MadeChoiceP2MessageCommand="playcommand,GoOff"
		GoOffCommand="linear,0.5;diffusealpha,0" 
	/>
    
    <Layer Class="AutoActor" 
        Condition="ITG3IsEncore() or ITG3IsFinal()"
		File="../ScreenSelectPlayMode underlay/explanation frame_encore" 
		OnCommand="horizalign,center;x,SCREEN_CENTER_X+100;y,SCREEN_CENTER_Y+125;diffusealpha,0;linear,0.5;diffusealpha,1.0" 
		MadeChoiceP1MessageCommand="playcommand,GoOff"
		MadeChoiceP2MessageCommand="playcommand,GoOff"
		GoOffCommand="linear,0.5;diffusealpha,0" 
	/>
		
		
		<Layer
		Class="AutoActor" 
		File="../_shared underlay arrows"
		OnCommand="x,184;playcommand,DoOn"
	/>
	<Layer
		Class="AutoActor" 
		File="../ScreenWithMenuElements underlay/_normaltop"
	/>
    
    <Layer
		Class="AutoActor" 
        Condition="IsITG3Encore() or IsITG3Final()"
		File="../ScreenWithMenuElements underlay/fore"
		OnCommand="playcommand,DoOn"
	/>
		</children>
</ActorFrame>
