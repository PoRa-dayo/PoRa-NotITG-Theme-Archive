<ActorFrame>
			<children>

    <Layer
		Type="Autoactor"
		File="../_expandtop/_width"
        Condition="not ITG3IsFinal()"
		InitCommand="x,SCREEN_LEFT+180;vertalign,top;horizalign,left;zoomtowidth,SCREEN_WIDTH-630;"
		OnCommand="y,SCREEN_TOP-100;y,SCREEN_TOP"
	/>


    
    <Layer
		Type="Autoactor"
		File="../_expandtop/_lside"
        Condition="not ITG3IsFinal()"
		InitCommand="x,SCREEN_LEFT;horizalign,left;vertalign,top"
		OnCommand="y,SCREEN_TOP-100;y,SCREEN_TOP"
	/>
    <Layer
		Type="Autoactor"
		File="../_expandtop/_rside"
        Condition="not ITG3IsFinal()"
		InitCommand="x,SCREEN_RIGHT;horizalign,right;vertalign,top"
		OnCommand="y,SCREEN_TOP-100;y,SCREEN_TOP"
	/>
    
    
    
    
    <Layer
		Type="Autoactor"
		File="../_expandtop/_widt final"
        Condition="ITG3IsFinal()"
		InitCommand="x,SCREEN_CENTER_X;vertalign,top;horizalign,center;zoomtowidth,SCREEN_WIDTH;"
		OnCommand="y,SCREEN_TOP-100;y,SCREEN_TOP"
	/>
			</children>
</ActorFrame>