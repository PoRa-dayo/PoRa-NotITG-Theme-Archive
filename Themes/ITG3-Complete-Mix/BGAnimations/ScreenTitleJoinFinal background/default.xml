<ActorFrame
OnCommand="%function(self)
		ResetCustomMods()
		InitializeSpeedMods()
		end"
		><children>
    <Layer
		File="../ScreenSelectMusic background/CJ126_Final"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomtowidth,SCREEN_WIDTH;zoomtoheight,SCREEN_HEIGHT"
		OffCommand="pause;linear,1.5;diffusealpha,0;"
	/>
		 <Layer
		File="../ScreenTitleMenu background/_lower.png"
		InitCommand="Additiveblend,1"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomtowidth,SCREEN_WIDTH;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;linear,3;croptop,+1;cropbottom,-0.8;sleep,1;queuecommand,On" 
	/> 
			 <Layer
		File="../ScreenTitleMenu background/_upper.png"
		InitCommand="Additiveblend,1"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomtowidth,SCREEN_WIDTH;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;linear,3;croptop,+1;cropbottom,-0.8;sleep,1;queuecommand,On" 
	/> 
		 <Layer
		File="../ScreenTitleMenu background/_lower.png"
		InitCommand="Additiveblend,1"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomtowidth,SCREEN_WIDTH;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;linear,3;croptop,+1;cropbottom,-0.8;sleep,1;queuecommand,On" 
	/> 
			 <Layer
		File="../ScreenTitleMenu background/_upper.png"
		InitCommand="Additiveblend,1"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomtowidth,SCREEN_WIDTH;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;linear,3;croptop,+1;cropbottom,-0.8;sleep,1;queuecommand,On" 
	/> 
    
    <Layer
		File="../ScreenTitleMenu background/_topright"
		InitCommand="Additiveblend,1"
		OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;diffusealpha,1;sleep,0.3;diffusealpha,1;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;sleep,0.5;diffusealpha,1;linear,3;croptop,+1;cropbottom,-0.8;sleep,0.3;queuecommand,On" 
		OffCommand="hidden,1"
	/> 
    <Layer
		File="../ScreenTitleMenu background/_center"
		InitCommand="Additiveblend,1"
		OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;diffusealpha,1;sleep,0.3;diffusealpha,1;croptop,-0.8;cropbottom,1;fadebottom,.45;fadetop,.45;sleep,0.8;diffusealpha,1.5;linear,3;croptop,+1;cropbottom,-0.8;sleep,0.3;queuecommand,On" 
		OffCommand="hidden,1"
    />
    <Layer
        File="../ScreenTitleMenu background/_2top"
        InitCommand="Additiveblend,1;rotationz,180"
        OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;cropright,-0.8;cropleft,1;fadeleft,.45;faderight,.45;sleep,.1;diffusealpha,1;linear,3;cropright,+1;cropleft,-0.8;sleep,0.25;queuecommand,On" 
		OffCommand="hidden,1"   
   /> 
   <Layer
        File="../ScreenTitleMenu background/_left"
        InitCommand="Additiveblend,1;rotationz,180"
        OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;cropright,-0.8;cropleft,1;fadeleft,.45;faderight,.45;sleep,.4;diffusealpha,1;linear,3;cropright,+1;cropleft,-0.8;sleep,0.2;queuecommand,On" 
		OffCommand="hidden,1"   
   />
   <Layer
        File="../ScreenTitleMenu background/_right"
        InitCommand="Additiveblend,1"
        OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;cropleft,-0.8;cropleft,1;faderight,.45;fadeleft,.45;sleep,.2;diffusealpha,1;linear,3;cropleft,+1;cropright,-0.8;sleep,0.5;queuecommand,On" 
		OffCommand="hidden,1"   
   /> 
   <Layer
        File="../ScreenTitleMenu background/_2center"
        InitCommand="Additiveblend,1"
        OnCommand="diffusealpha,1;stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;cropright,-0.8;cropleft,1;fadeleft,.45;faderight,.45;sleep,.4;diffusealpha,1;linear,3;cropright,+1;cropleft,-0.8;sleep,0.2;queuecommand,On" 
		OffCommand="hidden,1"   
   />

    <Layer
        File="glow final"
        OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;additiveblend,1;zoom,0;sleep,0.1;bounceend,0.4;zoom,1;diffuseshift;EffectColor1,#FFFFFF;EffectColor2,#FFFFFF00;Playcommand,set;effectperiod,5;effectoffset,.3"
    />
    <Layer
        File="newlogo final"
        OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;zoom,0;sleep,0.1;bounceend,0.4;zoom,1"
    />
    
    
  <Layer
        File="light final"
        OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;zoom,1;additiveblend,1;x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;playcommand,Diffuse;"				
        DiffuseCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;zoom,1;diffusealpha,0;sleep,2;linear,.3;diffusealpha,1;sleep,.05;linear,.5;diffusealpha,0;queuecommand,Diffuse"
		OffCommand="hidden,1"   
   />   
	  
	<Layer
        File="light final"
        OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;zoom,1;additiveblend,1;diffusealpha,0;"				
	GoodEndingMessageCommand="stoptweening;diffuse,#ffc600;linear,.3;diffusealpha,1;sleep,.25;linear,1;diffusealpha,0;"
	  />
	  
	  <Layer
        File="light final"
        OnCommand="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y-10;zoom,1;additiveblend,1;diffusealpha,0;"				
	GoodEndingMessageCommand="stoptweening;diffuse,#ffc600;linear,.3;diffusealpha,1;sleep,.25;linear,1;diffusealpha,0;"
	  />
      
      
       <Layer
	
		File="encore final"
		InitCommand="x,SCREEN_CENTER_X+103;y,SCREEN_CENTER_Y+95"
		OnCommand="horizalign,center;cropright,1.3;sleep,0.7;linear,1;cropright,-0.3"
		OffCommand="hidden,1"
   />
	  <Layer
	
		File="encore glow final"
		InitCommand="x,SCREEN_CENTER_X+103;y,SCREEN_CENTER_Y+95"
		OnCommand="horizalign,center;cropleft,-0.3;cropright,1;faderight,.1;fadeleft,.1;sleep,0.7;linear,1;cropleft,+1;cropright,-0.3"
		OffCommand="hidden,1"
	  
	    
    />

    <Layer
            File="up final"
            InitCommand="vertalign,top"
            OnCommand="x,SCREEN_CENTER_X;y,SCREEN_TOP-500;zoomto,SCREEN_WIDTH,SCREEN_HEIGHT;decelerate,0.4;y,SCREEN_TOP-50"
            OffCommand="accelerate,0.5;addy,-500"
        />
    <Layer
            File="base final"
            InitCommand="vertalign,bottom"
            OnCommand="x,SCREEN_CENTER_X;y,SCREEN_BOTTOM+100;decelerate,0.4;y,SCREEN_BOTTOM"
            OffCommand="accelerate,0.5;addy,100"
        />
	<!--
    <Layer
		File="../ScreenGameplay underlay/i"
	/>
		<Layer
		File="../ScreenGameplay underlay/i2"
	/>
    -->
	
	
  <Layer
        File="../ScreenTitleMenu background/encore/roxor"
         OnCommand="zoom,1;x,SCREEN_LEFT+50;y,SCREEN_TOP+19;diffusealpha,0;sleep,0.5;linear,0.5;diffusealpha,1"
		OffCommand="hidden,1" 
    />
    <Layer
        File="../_thanks/newbx"
        OnCommand="zoom,.8;x,SCREEN_LEFT+155;y,SCREEN_TOP+32;diffusealpha,0;sleep,0.5;linear,0.5;diffusealpha,1"
		OffCommand="hidden,1"
    /> 
    <Layer
        File="icon"
        OnCommand="addy,-5"
        OffCommand="accelerate,0.5;addy,-500"
    />
    
    
    <Layer
        File="add"
    OnCommand="sleep,8;queuecommand,Off"
	OffCommand="accelerate,0.3;addx,100"

    /> 
    
    
    
<!-- initial overlay quad (kung)-->	
<Layer
		Class="Quad"
		OnCommand="stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM;diffuse,#FFFFFF;diffusealpha,0;sleep,0.1;accelerate,0.5;diffusealpha,1;sleep,0.2;decelerate,0.5;diffusealpha,0"
	/>

</children>
</ActorFrame>