<ActorFrame>
	<children>
    <Layer
        File="CJ112"
        Condition="not ITG3IsFinal()"
        OnCommand="stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM"
    />
    
    <Layer
        File="CJ112_Final"
        Condition="ITG3IsFinal()"
        OnCommand="stretchto,SCREEN_LEFT,SCREEN_TOP,SCREEN_RIGHT,SCREEN_BOTTOM"
    />
    <!-- clear the zbuffer so that screens can draw without having to clear it -->
    <Layer
    Type="Quad"
    OnCommand="clearzbuffer,1;Zoom,0" />		
</children>
</ActorFrame>
