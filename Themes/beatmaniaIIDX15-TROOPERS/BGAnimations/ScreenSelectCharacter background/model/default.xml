<ActorFrame><children>

    <ActorFrame OnCommand="%function(self)
        self:fov(RealFOV(180))
    end"><children>

        <Layer
            Type="Model"
            Meshes="../../SelectStyle background/model/box.txt"
            Materials="../../SelectStyle background/model/box.txt"
            Bones="../../SelectStyle background/model/box.txt"
            Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomz,5;zoomx,6000;zoomy,6000;rotationx,-60;addy,-700;addx,-1100;rotationy,-60;rotationz,-110;addz,-4.8"
