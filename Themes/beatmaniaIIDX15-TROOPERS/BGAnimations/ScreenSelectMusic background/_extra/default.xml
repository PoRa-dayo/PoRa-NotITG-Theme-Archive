<ActorFrame><children>

    <ActorFrame OnCommand="%function(self)
        self:fov(RealFOV(90))
    end"><children>

        <Layer
            Type="Model"
            Meshes="1.txt"
            Materials="1.txt"
            Bones="1.txt"
            Command="zoomx,34;zoomy,34;zoomz,34;backfacecull,0;addz,100;rotationy,-35.3;x,SCREEN_CENTER_X+(190-320);rotationx,10;y,SCREEN_CENTER_Y+(207.5-240);rotationz,14;blend,add"
        />

    </children></ActorFrame>

    <ActorFrame OnCommand="%function(self)
        self:fov(RealFOV(90))
    end"><children>

        <Layer
            Type="Model"
            Meshes="a.txt"
            Materials="a.txt"
            Bones="a.txt"
            Command="zoomx,34;zoomy,34;zoomz,34;backfacecull,0;addz,100;rotationy,-35.5;x,SCREEN_CENTER_X+(190-320);rotationx,10;y,SCREEN_CENTER_Y+(207.5-240);rotationz,14;blend,add"
        />

