            self:linear(0.2)
            self:addy(120)
            self:zoomy(1)
            self:diffuse(1,1,1,1)
        end"
    />
    <Layer
        Type="ActorFrame"
        Condition="FUCK_EXE"
        OnCommand="x,SCREEN_WIDTH-98+102-15;y,SCREEN_CENTER_Y+50"
        UpdateScrollThumbMessageCommand="queuecommand,UpdateThumb"
        CurrentSongChangedMessageCommand="%function(self)
            if not BMIIDX15Glob.FirstTweening then
                BMIIDX15Glob.PrevCWI = CurWheelIndex()
                BMIIDX15Glob.DirCompare = BMIIDX15Glob.MusicWheelList[CurWheelIndex()]:GetY()
            end
        end"
        UpdateThumbCommand="%function(self)
            local ScrollBarEle = SCREENMAN:GetTopScreen():GetChild('MusicWheel'):GetChild('')
            local EndDelta = 0
            local T1ZoomY = ScrollBarEle:GetChildAt(1):GetZoomY()
            local T2ZoomY = ScrollBarEle:GetChildAt(2):GetZoomY()
            local T1Y = ScrollBarEle:GetChildAt(1):GetY()
            local T2Y = ScrollBarEle:GetChildAt(2):GetY()
            
            if not BMIIDX15Glob.FirstTweening then
                self:finishtweening()
                self:decelerate(0.1)
            end
            if T2ZoomY >= T1ZoomY+0.01 then
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T1ZoomY/T2ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T2Y+EndDelta +58)
            else
                if T2ZoomY > 0 then
                    EndDelta = (T1ZoomY/2)*(T2ZoomY/T1ZoomY)
                end
                self:y(SCREEN_CENTER_Y+T1Y-EndDelta +58)
            end
            
            if not BMIIDX15Glob.FirstTweening then
                local NewDirCompare = BMIIDX15Glob.MusicWheelList[BMIIDX15Glob.PrevCWI or CurWheelIndex()]:GetY()
                if BMIIDX15Glob.DirCompare and BMIIDX15Glob.DirCompare < NewDirCompare then
                    BMIIDX15Glob.DirCompare = nil
                    MESSAGEMAN:Broadcast('ScrollUp')
                elseif BMIIDX15Glob.DirCompare and BMIIDX15Glob.DirCompare > NewDirCompare then
                    BMIIDX15Glob.DirCompare = nil
                    MESSAGEMAN:Broadcast('ScrollDown')
                end
            end
        end"
    ><children>
        <Layer
            File="ScrollBar thumb"
            OnCommand="%function(self)
                self:blend('add')
                self:diffuse(0,0,0,0)
                self:sleep(0.4)
                self:linear(0.2)
                self:diffuse(1,1,1,1)
            end"
        />
        <Layer
            File="ScrollBar thumb"
            OnCommand="%function(self)
                self:blend('add')
                self:diffuseramp()
                self:effectcolor1(1,1,1,0)
                self:effectcolor2(1,1,1,0.5)
                
                self:diffuse(0,0,0,0)
                self:sleep(0.4)
                self:linear(0.2)
                self:diffuse(1,1,1,1)
            end"
        />
    </children></Layer>
    <Layer
        File="ScrollBar thumb"
        OnCommand="%function(self)
            self:blend('add')
            self:zoomy(0.3)
            self:x(SCREEN_WIDTH-98+102-15)
            self:y(SCREEN_CENTER_Y-240/2-self:GetHeight()/2+24 +58)
