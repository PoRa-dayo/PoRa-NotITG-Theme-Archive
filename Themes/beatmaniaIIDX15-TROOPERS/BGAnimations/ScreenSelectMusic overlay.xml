--better avoid using GAMESTATE:GetEasiestStepsDifficulty() too many times as it lowers performance
--WheelSelect and UpdateScroll have to be called continuously to not be faulty
<ActorFrame
    OnCommand="queuecommand,UpdateScroll"
    CurrentSongChangedMessageCommand="%function(self)
        MESSAGEMAN:Broadcast('Update')
        MESSAGEMAN:Broadcast('SongUpdate')
    end"
    CurrentStepsP1ChangedMessageCommand="%function(self)
        if not GAMESTATE:IsCourseMode() then
            local temp = GAMESTATE:GetEasiestStepsDifficulty()
            if temp < 6 then
                BMIIDX15Glob.CurDiff = GAMESTATE:GetEasiestStepsDifficulty()
            end
        end
        MESSAGEMAN:Broadcast('Update')
    end"
    CurrentStepsP2ChangedMessageCommand="%function(self)
        if not GAMESTATE:IsCourseMode() then
            local temp = GAMESTATE:GetEasiestStepsDifficulty()
            if temp < 6 then
                BMIIDX15Glob.CurDiff = GAMESTATE:GetEasiestStepsDifficulty()
            end
        end
        MESSAGEMAN:Broadcast('Update')
    end"
    UpdateScrollCommand="%function(self)
        if BMIIDX15Glob.ScrollUpdateNOW then return end
        BMIIDX15Glob.ScrollUpdateNOW=true
        self:queuecommand('Scroll')
    end"
    ScrollCommand="%function(self)
        if BMIIDX15Glob.ScrollUpdateNOW then
            MESSAGEMAN:Broadcast('UpdateScrollThumb')
            self:sleep(0.1)
            self:queuecommand('UpdateScroll')
            self:queuecommand('WheelSelect')
        end
        BMIIDX15Glob.ScrollUpdateNOW = false
    end"
    WheelSelectCommand="%function(self)
        UpdateWheelSelection()
    end"
    ><children>
    
        
    <!--CurrentSongChanged is not used here because the Artist commands in [TextBanner] in metrics.ini do a better job. -->
    <!--As CurrentSongChanged is not activated when the player opens a group. -->
    <!--The YouShouldChangeThatShitNOW is to minimize the amount of times UpdateWheelTitles gets called-->
    <!--Similarly, ScrollUpdateNOW is to minimize the amount of times UpdateWheelSelection gets called-->
    <Layer
        Type="Quad"
        OnCommand="%function(self)
            BMIIDX15Glob.MusicWheelList = {}
            BMIIDX15Glob.ArtistTitles = {}
            BMIIDX15Glob.DiffNumTitles = {}
            BMIIDX15Glob.SelectedWheelItems = {}
            BMIIDX15Glob.FirstTweening=true
            BMIIDX15Glob.Rand=1
            BMIIDX15Glob.DirCompare=nil
            self:sleep(0.1)
            self:queuecommand('FirstUpdate')
            self:sleep(0.5)
            self:queuecommand('Disallow')
        end"
        DisallowCommand="%function(self)
            BMIIDX15Glob.FirstTweening=false
        end"
        FirstUpdateCommand="%function(self)
            UpdateWheelTitles(true)
            BMIIDX15Glob.YouShouldChangeThatShitNOW = false
            BMIIDX15Glob.ScrollUpdateNOW = false
        end"
        UpdateMessageCommand="%function(self)
            if BMIIDX15Glob.YouShouldChangeThatShitNOW then return end
            BMIIDX15Glob.YouShouldChangeThatShitNOW=true
            self:queuecommand('Wheel')
        end"
        WheelCommand="%function(self)
            if BMIIDX15Glob.YouShouldChangeThatShitNOW then
                UpdateWheelTitles()
            end
            BMIIDX15Glob.YouShouldChangeThatShitNOW = false
        end"/>
        
    <Layer
        File="ScreenSelectMusic score frame p1"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="x,128;y,SCREEN_CENTER_Y+(455-240);draworder,99;addx,-300;linear,0.25;addx,300"/>
        
    <Layer
        File="ScreenSelectMusic score frame p1"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_2)"
        OnCommand="x,SCREEN_WIDTH-(640-516);y,SCREEN_CENTER_Y+(455-240);draworder,99;addx,300;linear,0.25;addx,-300"/>
        
    <Layer
        Type="BitmapText"
        Font="songtitle 16px"
        Text="Mirin Template"
        OnCommand="zoom,0.8;zoomx,0.7;maxwidth,460;draworder,33;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-80;horizalign,right;shadowlength,0;addx,-24;addy,7;decelerate,0.2;addx,24;addy,-7"
        OffCommand=""
        SongUpdateMessageCommand="%function(self) 
            if not BMIIDX15Glob.FirstTweening then self:finishtweening() end

            local song = GAMESTATE:GetCurrentSong()
            local course = GAMESTATE:GetCurrentCourse()
            local ind = CurWheelIndex()
            if song then
                if not BMIIDX15Glob.FirstTweening then
                    self:diffusealpha(0)
                    self:addx(-24)
                    self:addy(7)
                end
                
                self:settext(song:GetDisplayMainTitle())
                
                if not BMIIDX15Glob.FirstTweening then
                    self:decelerate(0.2)
                    self:diffusealpha(1)
                    self:addx(24)
                    self:addy(-7)
                end
            elseif course then
                self:settext(course:GetDisplayFullTitle())
            elseif IsRoulette(ind) then
                BMIIDX15Glob.Rand = math.random(BMIIDX15Glob.TotalSongNum)
                self:settext(BMIIDX15Glob.AllSongs[BMIIDX15Glob.Rand]:GetDisplayMainTitle())
                self:sleep(0.05)
                self:queuecommand('SongUpdate')
            else
                self:settext('')
                self:sleep(0.1)
                self:queuecommand('SongUpdate')
            end
        end"/>
    <Layer
        Type="BitmapText"
        Font="artist 16px"
        Text="Subtitle"
        Condition="not GAMESTATE:IsCourseMode()"
        OnCommand="zoom,0.6;maxwidth,550;draworder,34;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-100;horizalign,right;shadowlength,0;addx,15;addy,-7;decelerate,0.2;addx,-15;addy,7"
        OffCommand=""
        SongUpdateMessageCommand="%function(self)
            if not BMIIDX15Glob.FirstTweening then self:finishtweening() end
            local ind = CurWheelIndex()
            local song = GAMESTATE:GetCurrentSong()
            if song then
                if not BMIIDX15Glob.FirstTweening then
                    self:diffusealpha(0)
                    self:addx(15)
                    self:addy(-7)
                end
                
                self:settext(song:GetDisplaySubTitle())
                
                if not BMIIDX15Glob.FirstTweening then
                    self:decelerate(0.2)
                    self:diffusealpha(1)
                    self:addx(-15)
                    self:addy(7)
                end
            elseif IsRoulette(ind) then
                self:settext(BMIIDX15Glob.AllSongs[BMIIDX15Glob.Rand]:GetDisplaySubTitle())
                self:sleep(0.05)
                self:queuecommand('SongUpdate')
            else
                self:settext('')
                self:sleep(0.1)
                self:queuecommand('SongUpdate')
            end
        end" />
    <Layer
        Type="BitmapText"
        Font="artist 16px"
        Text="Artist"
        Condition="not GAMESTATE:IsCourseMode()"
        OnCommand="x,SCREEN_CENTER_X+(340-320);y,SCREEN_CENTER_Y+(180-240);maxwidth,550;zoom,0.6;draworder,34;shadowlength,0;horizalign,right;addx,-15;addy,-7;decelerate,0.2;addx,15;addy,7"
        OffCommand=""
        SongUpdateMessageCommand="%function(self)
            if not BMIIDX15Glob.FirstTweening then self:finishtweening() end
            
            local ind = CurWheelIndex()
            local song = GAMESTATE:GetCurrentSong()
            if song then
                if not BMIIDX15Glob.FirstTweening then
                    self:diffusealpha(0)
                    self:addx(-15)
                    self:addy(-7)
                end
                
                self:settext(song:GetDisplayArtist())
                
                if not BMIIDX15Glob.FirstTweening then
                    self:sleep(0.1)
                    self:decelerate(0.2)
                    self:diffusealpha(1)
                    self:addx(15)
                    self:addy(7)
                end
            elseif IsRoulette(ind) then
                self:settext(BMIIDX15Glob.AllSongs[BMIIDX15Glob.Rand]:GetDisplayArtist())
                self:sleep(0.05)
                self:queuecommand('SongUpdate')
            else
                self:settext('')
                self:sleep(0.1)
                self:queuecommand('SongUpdate')
            end
        end" />
    <Layer
        Type="BitmapText"
        Font="../Numbers/BPMDisplay bpm"
        Text=""
        Condition="not GAMESTATE:IsCourseMode()"
        OnCommand="x,SCREEN_CENTER_X+(340-320);y,SCREEN_CENTER_Y+(301-240);shadowlength,1;horizalign,right"
        OffCommand=""
        SongUpdateMessageCommand="%function(self)
            self:finishtweening()
            local ind = CurWheelIndex()
            local song = GAMESTATE:GetCurrentSong()
            if (not song) and IsRoulette(ind) then
                self:settext(string.format('%03d', math.floor(BMIIDX15Glob.AllSongs[BMIIDX15Glob.Rand]:GetMinBPM())))
                self:sleep(0.05)
                self:queuecommand('SongUpdate')
            else
                self:settext('')
                self:sleep(0.1)
                self:queuecommand('SongUpdate')
            end
        end" />
        
    <!--shows up when a group is selected-->    
    <ActorFrame Condition="FUCK_EXE"
    UpdateMessageCommand="%function(self) 
        self:finishtweening()
        self:sleep(0.1)
        self:queuecommand('Recheck')
    end"
    RecheckCommand="%function(self)
        local ind = CurWheelIndex()
        local group = BMIIDX15Glob.GroupTitles[ind]
        if (not GAMESTATE:GetCurrentSong()) and (not IsRoulette(ind)) and GAMESTATE:GetSortOrder() ~= 13 and group then
            self:hidden(0)
        else
            self:hidden(1)
        end
    end" ><children>
        <Layer
            Type="BitmapText"
            Font="Common Normal"
            Text="CATEGORY SELECT_"
            Condition="not GAMESTATE:IsCourseMode()"
            OnCommand="zoom,0.4;zoomx,0.9;draworder,32;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-110;horizalign,right;shadowlength,0;maxwidth,150;"
            OffCommand=""
            UpdateCommand="%function(self)
                self:cropright(1)
                self:linear(0.5)
                self:cropright(0)
            end"
            />  
        <Layer
            Type="BitmapText"
            Font="grouptitle 16px"
            Text="Group Name"
            OnCommand="zoom,0.8;zoomx,0.7;draworder,33;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-88;horizalign,right;shadowlength,0;maxwidth,460;"
            OffCommand=""
            UpdateMessageCommand="%function(self) 
                self:finishtweening()
                self:diffusealpha(0)
                self:addx(-24)
                self:linear(0.1)
                self:diffusealpha(0.3)
                self:addx(12)
                self:queuecommand('Group')
                self:decelerate(0.1)
                self:diffusealpha(1)
                self:addx(12)
            end"
            GroupCommand="%function(self)
                local ind = CurWheelIndex()
                local group = BMIIDX15Glob.GroupTitles[ind]
                if (not GAMESTATE:GetCurrentSong()) and group then
                    self:settext(group)
                else
                    self:settext('')
                end
            end" />
        <Layer
            Type="BitmapText"
            Font="font"
            Text="MUSIC NUMBER"
            Condition="not GAMESTATE:IsCourseMode()"
            OnCommand="zoom,0.8;zoomy,0.9;draworder,32;x,SCREEN_CENTER_X-40;y,SCREEN_CENTER_Y-62;horizalign,right;shadowlength,0;"
            OffCommand=""
            UpdateMessageCommand="%function(self) 
                self:finishtweening()
                local ind = CurWheelIndex()
                local group = BMIIDX15Glob.GroupTitles[ind]
                if GAMESTATE:GetSortOrder() ~= 1 then
                    self:hidden(1)
                else
                    self:hidden(0)
                end
            end" />
        <Layer
            Type="BitmapText"
            Font="font"
            Text=""
            Condition="not GAMESTATE:IsCourseMode()"
            OnCommand="zoom,0.8;zoomy,0.9;draworder,32;x,SCREEN_CENTER_X+20;y,SCREEN_CENTER_Y-62;horizalign,right;shadowlength,0;maxwidth,150;"
            OffCommand=""
            UpdateMessageCommand="%function(self) 
                self:finishtweening()
                if GAMESTATE:GetSortOrder() ~= 1 then
                    self:hidden(1)
                else
                    self:hidden(0)
                end
                self:sleep(0.1)
                self:queuecommand('Group')
            end" 
            GroupCommand="%function(self)
                local ind = CurWheelIndex()
                local group = BMIIDX15Glob.GroupTitles[ind]
                local SongNum = GAMESTATE:PlayerUsingBothSides() and BMIIDX15Glob.GroupSongNumDoubles[group] or BMIIDX15Glob.GroupSongNum[group]
                if (not GAMESTATE:GetCurrentSong()) and SongNum then
                    self:settext(SongNum)
                else
                    self:settext('')
                end
            end" />
    </children></ActorFrame>
        
        
