<ActorFrame><children>

    <ActorFrame OnCommand="%function(self)
        self:fov(RealFOV(180))
    end"><children>

        <Layer
            Type="Model"
            Meshes="../../SelectStyle background/model/box.txt"
            Materials="../../SelectStyle background/model/box.txt"
            Bones="../../SelectStyle background/model/box.txt"
            Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomz,5;zoomx,6000;zoomy,6000;rotationx,60;addy,500;addx,-500;rotationy,60;rotationz,70;addz,-3.3"
            UseLightning="1"
        />

    </children></ActorFrame>

    <ActorFrame OnCommand="%function(self)
        self:fov(RealFOV(180))
    end"><children>

        <Layer
            Type="Model"
            Meshes="../../SelectStyle background/model/gate.txt"
            Materials="../../SelectStyle background/model/gate.txt"
            Bones="../../SelectStyle background/model/gate.txt"
            Command="x,SCREEN_CENTER_X;y,SCREEN_CENTER_Y;zoomz,5;zoomx,6000;zoomy,6000;rotationx,60;addy,500;addx,-500;rotationy,60;rotationz,70;addz,-5.6"
            UseLightning="0"
        />

    </children></ActorFrame>

</children></ActorFrame>