<ActorFrame><children>
	<!--

		Jose's Dialog System
		XML Segment
		Version 2.4
		(c) 2018, Jose_Varela
		It might not be robust nor complex as UnderText, but, it's more simple that
		anyone can understand how to use the system.

	-->
<Layer Type="ActorFrame" OnCommand="%function(self)

	if DialogTextBank[TextBankData1] ~= nil then
		if DialogTextBank[TextBankData1][TextBankData2] ~= nil then
			self:hidden(0)
		else
			self:hidden(1)
		end
	else
		self:hidden(1)
	end
end"><children>
		<Layer File="@ThemeFile('Mugshots 3x2')"
			InitCommand="%function(self) InitializeFace(self) end"
			StartImageTweenCommand="%function(self) LoadCharacterIcon(self) end"
			UpdateCharacterInfoCommand="%function(self) GRABBER_NewFace(self) end"
			HideTextBoxMessageCommand="%function(self) self:hidden(1) end"
			ShowTextBoxMessageCommand="%function(self) self:hidden(0) end"
			/>
	
		<Layer Font="Common Normal" Text="Dialog"
			InitCommand="%function(self) LoadCharacterData(self) self:queuecommand('PlayText') end"
			PlayTextCommand="%function(self) SleepData(self) end"
			UpdateCharacterInfoCommand="%function(self) LoadNewCharacterData(self) end"
			HideTextBoxMessageCommand="%function(self) self:hidden(1) end"
			ShowTextBoxMessageCommand="%function(self) self:hidden(0) end"
			/>
	
		<Layer Font="Common Normal" Text="Dialog"
			InitCommand="%function(self) InitializeDialog(self) end"
			PlayTextCommand="%function(self) PlayDialog(self) end"
			UpdateTextStringCommand="%function(self) GRABBER_NewText(self) end"
			HideTextBoxMessageCommand="%function(self) self:hidden(1) end"
			ShowTextBoxMessageCommand="%function(self) self:hidden(0) end"
			/>
</children></Layer>

