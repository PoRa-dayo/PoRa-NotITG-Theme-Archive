--the diff hints that show up to indicate easier/harder difficulties existing
        <Layer
            File="../diff_hint"
            Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
            OnCommand="zoom,0.5;x,10;y,150;diffuseshift;effectcolor1,0.5,0.5,0.5,0.5;effectcolor2,#FFFFFF"
            OffCommand="diffusealpha,1;accelerate,0.25;diffusealpha,0"
            CurrentStepsP1ChangedMessageCommand="%function(self)
                if IsEasierDifficulty(PLAYER_1) then
                    self:hidden(0)
                else
                    self:hidden(1)
                end
            end"
        />
