--song artist 
		<Layer
		Font="Paintball"
		Text="Song name"
		OnCommand="%function(self)
		
		self:x(0)
		self:y(45)
		self:zoom(.3)
		self:horizalign('left')
		self:shadowlength(1)
		self:maxwidth(SCREEN_WIDTH/1.5)
		self:rotationy(-5)
		self:rotationz(-1)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		InitCommand="animate,0;playcommand,UpdateStart"
		CurrentSongChangedMessageCommand="playcommand,UpdateStart"
		UpdateStartCommand="%function(self)
				self:finishtweening()
				self:accelerate(0.1)
				self:x(-10)
				self:diffusealpha(0)
				self:sleep(0.001)
				self:queuecommand('Update')
		end"
		UpdateCommand="%function(self)
			self:x(20)
            local songg = GAMESTATE:GetCurrentSong()
            local coursee = GAMESTATE:GetCurrentCourse()
			if songg or coursee then
				self:hidden(0)
				self:diffuse(1,1,1,0)
                if songg then
                    self:settext(songg:GetDisplayArtist())
                else
                    self:settext(SCREENMAN:GetTopScreen():GetChild('ArtistDisplay'):GetText())
                end
				self:decelerate(0.1)
			else
				self:hidden(1)
			end
			self:x(10)
			self:diffusealpha(1)
            if coursee then
                self:sleep(0.2)
				self:queuecommand('SlightUpdate')
            end
		end"
        SlightUpdateCommand="%function(self)
            if GAMESTATE:GetCurrentCourse() then
                self:settext(SCREENMAN:GetTopScreen():GetChild('ArtistDisplay'):GetText())
            end
            self:sleep(0.2)
			self:queuecommand('SlightUpdate')
		end"
		/>
