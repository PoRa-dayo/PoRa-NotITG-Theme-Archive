		/>
--times played
		<Layer
		Font="Paintball"
		Text="Song name"
		OnCommand="%function(self)
		
		self:x(10)
		self:y(-20)
		self:zoom(.2)
		self:horizalign('left')
		self:shadowlength(1)
		self:maxwidth(SCREEN_WIDTH/1.5)
		self:rotationy(-4.5)
		self:rotationz(-1)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		InitCommand="animate,0;playcommand,UpdateStart"
		CurrentSongChangedMessageCommand="playcommand,UpdateStart"
		UpdateStartCommand="%function(self)
				self:finishtweening()
				self:accelerate(0.1)
				self:zoom(0.18)
				self:diffusealpha(0)
				self:sleep(0.001)
				self:queuecommand('Update')
		end"
		UpdateCommand="%function(self)
			self:zoom(0.18)
			if GAMESTATE:GetCurrentSong() then
				self:hidden(0)
				self:diffuse(1,1,1,0)
				if PROFILEMAN:GetMachineProfile():GetSongNumTimesPlayed(GAMESTATE:GetCurrentSong()) > 0 then
					self:settext( THEME:GetMetric('PaneDisplay', 'Played')..PROFILEMAN:GetMachineProfile():GetSongNumTimesPlayed(GAMESTATE:GetCurrentSong()) )
				else
					self:settext( THEME:GetMetric('PaneDisplay', 'NeverPlayed') )
					self:diffusetopedge(1,0,1,1)
					self:diffusebottomedge(0,1,1,1)
				end
				self:decelerate(0.1)
			else
				self:hidden(1)
			end
			self:zoom(0.3)
			self:diffusealpha(1)
		end"
		/>
--no. of songs (replaces times played in Marathon mode)
		<Layer
		Font="Paintball"
		Text="Song name"
		OnCommand="%function(self)
		
		self:x(10)
		self:y(-20)
		self:zoom(.2)
		self:horizalign('left')
		self:shadowlength(1)
		self:maxwidth(SCREEN_WIDTH/1.5)
		self:rotationy(-4.5)
		self:rotationz(-1)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		InitCommand="animate,0;playcommand,UpdateStart"
		CurrentSongChangedMessageCommand="playcommand,UpdateStart"
		UpdateStartCommand="%function(self)
				self:finishtweening()
				self:accelerate(0.1)
				self:zoom(0.18)
				self:diffusealpha(0)
				self:sleep(0.001)
				self:queuecommand('Update')
		end"
		UpdateCommand="%function(self)
			self:zoom(0.18)
			if GAMESTATE:GetCurrentCourse() then
				self:hidden(0)
				self:diffuse(1,1,1,0)
                local SongNumTxt = SCREENMAN:GetTopScreen():GetChild('NumSongs'):GetText()
                if SongNumTxt then
                    if tonumber(SongNumTxt) == 1 then
                        self:settext( THEME:GetMetric('PaneDisplay', 'Contains')..' '..SongNumTxt..' '..THEME:GetMetric('PaneDisplay', 'NumSong') )
                    else 
                        self:settext( THEME:GetMetric('PaneDisplay', 'Contains')..' '..SongNumTxt..' '..THEME:GetMetric('PaneDisplay', 'NumSongs') )
                    end
                    if tonumber(SongNumTxt) > 5 then
                        self:diffusetopedge(1,0,1,1)
                        self:diffusebottomedge(1,1,0,1)
                    end
                end
				self:decelerate(0.1)
			else
				self:hidden(1)
			end
			self:zoom(0.3)
			self:diffusealpha(1)
		end"
		/>
--high score
        <Layer
            Font="Paintball"
            Text="Song name"
            OnCommand="%function(self)
            
            self:x(140)
            self:y(-10)
            self:zoom(.2)
            self:horizalign('left')
            self:shadowlength(1)
            self:maxwidth(SCREEN_WIDTH/1.5)
            self:rotationy(-4.5)
            self:rotationz(-1)
            end"
            OffCommand="linear,0.3;diffusealpha,0"
            InitCommand="animate,0;playcommand,UpdateStart"
            CurrentStepsP1ChangedMessageCommand="playcommand,UpdateStart"
            CurrentStepsP2ChangedMessageCommand="playcommand,UpdateStart"
            UpdateStartCommand="%function(self)
                    self:finishtweening()
                    self:accelerate(0.1)
                    self:zoom(0.18)
                    self:diffusealpha(0)
                    self:sleep(0.001)
                    self:queuecommand('Update')
            end"
            UpdateCommand="%function(self)
                self:zoom(0.18)
                local panep1=SCREENMAN:GetTopScreen():GetChild('PaneDisplayP1')
                local panep2=SCREENMAN:GetTopScreen():GetChild('PaneDisplayP2')
                local scoretxt1 = '?'
                local scoretxt2 = '?'
                if panep1 or panep2 then
                    if GAMESTATE:GetCurrentSong() then
                        if panep1 then scoretxt1 = panep1:GetChild(''):GetChild('MachineHighScoreText'):GetText() end
                        if panep2 then scoretxt2 = panep2:GetChild(''):GetChild('MachineHighScoreText'):GetText() end
                    elseif GAMESTATE:GetCurrentCourse() then
                        if panep1 then scoretxt1 = panep1:GetChild(''):GetChild('CourseMachineHighScoreText'):GetText() end
                        if panep2 then scoretxt2 = panep2:GetChild(''):GetChild('CourseMachineHighScoreText'):GetText() end
                    end
                    self:hidden(0)
                    self:diffuse(1,1,1,0)
                    self:decelerate(0.1)
                else
                    self:hidden(1)
                end
                if panep1 and panep2 then
                    self:settext( THEME:GetMetric('PaneDisplay', 'HighScore')..scoretxt1..' / '..scoretxt2 )
                elseif panep1 and not panep2 then
                    self:settext( THEME:GetMetric('PaneDisplay', 'HighScore')..scoretxt1)
                elseif panep1 and not panep2 then
                    self:settext( THEME:GetMetric('PaneDisplay', 'HighScore')..scoretxt2)
                else
                    self:settext( THEME:GetMetric('PaneDisplay', 'HighScore')..'?')
                end
                self:zoom(0.3)
                self:diffusealpha(1)
            end"
		/>











--song length
		<Layer
		Font="Paintball"
		Text="Song name"
		OnCommand="%function(self)
		
		self:x(220)
		self:y(20)
		self:zoom(.3)
		self:horizalign('left')
		self:shadowlength(1)
		self:maxwidth(SCREEN_WIDTH/1.5)
		self:rotationy(-5)
		self:rotationz(-1)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		InitCommand="animate,0;playcommand,UpdateStart"
		CurrentSongChangedMessageCommand="playcommand,UpdateStart"
		UpdateStartCommand="%function(self)
				self:finishtweening()
				self:accelerate(0.1)
				self:y(30)
				self:diffusealpha(0)
				self:sleep(0.001)
				self:queuecommand('Update')
		end"
		UpdateCommand="%function(self)
			MESSAGEMAN:Broadcast('UpdateSortOrder')
			self:y(30)
			if GAMESTATE:GetCurrentSong() then
				self:hidden(0)
				self:diffuse(1,1,1,0)
				self:decelerate(0.1)
				if GAMESTATE:GetCurrentSong():MusicLengthSeconds() >= 3600 then
					self:settext(SecondsToHHMMSS(GAMESTATE:GetCurrentSong():MusicLengthSeconds()))
				else
					self:settext(SecondsToMMSS(GAMESTATE:GetCurrentSong():MusicLengthSeconds()))
				end
			elseif GAMESTATE:GetCurrentCourse() then
				self:hidden(0)
				self:diffuse(1,1,1,0)
				self:decelerate(0.1)
                local TheTrail = GAMESTATE:GetCurrentTrail(0) or GAMESTATE:GetCurrentTrail(1)
				self:settext(SecondsToMMSS( TheTrail:GetLengthSeconds()))
			else
				self:hidden(1)
			end
			self:y(20)
			self:diffusealpha(1)
		end"
		/>
        
