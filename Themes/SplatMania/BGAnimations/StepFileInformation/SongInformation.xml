<ActorFrame><children>
--Song Information/Course Information header
	<Layer
		Font="Paintball"
		Text="@THEME:GetMetric('PaneDisplay', 'TopHeaderText')"
		OnCommand="%function(self)
		
		self:zoom(0.3)
		self:horizalign('left')
		self:shadowlength(1)
		self:rotationy(-3)
        if GAMESTATE:IsCourseMode() then
            self:settext(THEME:GetMetric('PaneDisplay', 'TopHeaderTextCourse'))
		end
        end"
		OffCommand="linear,0.3;diffusealpha,0"
		/>
--the Course Contents header, only for course mode       
    <Layer
		Font="Paintball"
		Text="@THEME:GetMetric('PaneDisplay', 'BottomHeaderTextCourse')"
		OnCommand="%function(self)
		if not GAMESTATE:IsCourseMode() then self:hidden(1) end
		self:zoom(0.3)
        self:y(82)
		self:horizalign('left')
		self:shadowlength(1)
		self:rotationy(-3)
        self:settext(THEME:GetMetric('PaneDisplay', 'BottomHeaderTextCourse'))
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		/>
--song title
		<Layer
		Font="Paintball"
		Text="Song name"
		OnCommand="%function(self)
		
		self:x(0)
		self:y(30)
		self:zoom(.5)
		self:horizalign('left')
		self:shadowlength(1)
		self:maxwidth(450)
		self:rotationy(-5)
		self:rotationz(-1)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		InitCommand="animate,0;playcommand,UpdateStart"
		CurrentSongChangedMessageCommand="playcommand,UpdateStart"
		UpdateStartCommand="%function(self)
				self:finishtweening()
				self:accelerate(0.1)
				self:x(-10)
				self:diffusealpha(0)
				self:sleep(0.001)
				self:queuecommand('Update')
		end"
		UpdateCommand="%function(self)
			self:x(20)
			if GAMESTATE:GetCurrentSong() then
				self:hidden(0)
				self:diffuse(1,1,1,0)
				local song = GAMESTATE:GetCurrentSong();
				self:settext(GAMESTATE:GetCurrentSong():GetDisplayMainTitle())
				if string.len( SPCommand:GetDisplaySubtitle() ) > 0 then
					self:zoom(0.4)
					self:y(20)
				else
					self:y(30)
					self:zoom(.5)
				end
			elseif GAMESTATE:GetCurrentCourse() then
                self:hidden(0)
				self:diffuse(1,1,1,0)
				self:settext(GAMESTATE:GetCurrentCourse():GetDisplayFullTitle())
				self:y(30)
                self:zoom(.5)
            else
				self:hidden(1)
			end
			self:decelerate(0.1)
			self:x(10)
			self:diffusealpha(1)
		end"
		/>
