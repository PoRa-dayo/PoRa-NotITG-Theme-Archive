<ActorFrame><children>
--P1 diff num
    <Layer
		Font="Paintball"
		Text=" "
		Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1) and GAMESTATE:IsHumanPlayer(PLAYER_1)"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X-75)
		self:y(SCREEN_CENTER_Y+45)
        self:maxwidth(40)
		self:horizalign('right')
		self:shadowlength(1)
		self:rotationy(-7)
		self:queuecommand('SetNow')
		end"
		SetNowCommand="%function(self)
		if GAMESTATE:GetCurrentSong() then

			self:settext( GAMESTATE:GetCurrentSteps(PLAYER_1):GetMeter() )
			local Diff = GAMESTATE:GetCurrentSteps(PLAYER_1):GetDifficulty()+1
			
			for i=1,table.getn(DiffColorTable) do
				if Diff == i then
					self:diffuse( DiffColorTable[i][2][1],DiffColorTable[i][2][2],DiffColorTable[i][2][3],DiffColorTable[i][2][4] )
				end
			end

		else
			self:settext('ND')
			self:diffuse(1,1,1,0.5)
		end
		self:queuecommand('AnimationStart')
		end"
		AnimationStartCommand="%function(self) self:x(SCREEN_CENTER_X-275) end"
		CurrentStepsP1ChangedMessageCommand="sleep,0.01;queuecommand,SetNow"
		/>

