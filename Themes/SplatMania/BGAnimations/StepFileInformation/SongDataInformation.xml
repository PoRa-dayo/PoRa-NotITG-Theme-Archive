		self:y(SCREEN_CENTER_Y+50)
		self:horizalign('left')
		self:shadowlength(1)
		self:zoom(0.5)
		self:maxwidth(170)
		self:rotationy(-5)
		self:queuecommand('SetNow')
		end"
		SetNowCommand="%function(self)
