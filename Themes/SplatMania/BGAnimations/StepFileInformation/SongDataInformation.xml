		<Layer
		Font="Paintball"
		Text="@THEME:GetMetric('PaneDisplay', 'BottomHeaderText')"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X-310)
		self:y(SCREEN_CENTER_Y+22)
		self:zoom(0.3)
		self:horizalign('left')
		self:shadowlength(1)
		self:rotationy(-1)
		self:rotationz(2)
		end"
		OffCommand="linear,0.3;diffusealpha,0"
		/>

		<Layer
		Type="Quad"
		Condition="GAMESTATE:IsHumanPlayer(PLAYER_1) and GAMESTATE:IsHumanPlayer(PLAYER_2)"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X-180)
		self:y(SCREEN_CENTER_Y+115)
		self:zoomto(2,80,0,0)
		self:rotationy(-1)
		self:fadetop(0.1)
		self:fadebottom(0.1)
		self:rotationz(2)
		end"
		/>

		<Layer Type="ActorFrame" Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1) and GAMESTATE:IsHumanPlayer(PLAYER_1)" Command="x,SCREEN_CENTER_X-320;y,SCREEN_CENTER_Y+85;rotationy,-15;zoom,1.5"><children>

			<Layer File="RadarValues/PLAYER_1/StepsInfo.xml" OnCommand="%function(self) XOffset = 20; end" />

