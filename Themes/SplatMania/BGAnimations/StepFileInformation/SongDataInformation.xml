--P1 step artist
		<Layer
		Font="Paintball"
		Text=" "
		Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1) and GAMESTATE:IsHumanPlayer(PLAYER_1)"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X-75)
		self:y(SCREEN_CENTER_Y+60)
		self:horizalign('left')
		self:shadowlength(1)
		self:zoom(0.5)
		self:maxwidth(170)
		self:rotationy(-5)
		self:queuecommand('SetNow')
		end"
		SetNowCommand="%function(self)
		if GAMESTATE:GetCurrentSong() then


            self:diffuse(1,1,1,0.5)
            if GetStepsDescriptionText(PLAYER_1) == '' then
                self:settext( 'Creator Not Set!' )
                self:diffuse(1,0,0,0.5)
            else
                self:settext( 'By: '..GetStepsDescriptionText(PLAYER_1) )
            end
            self:zoom(0.4)

		else
			self:settext('No data')
