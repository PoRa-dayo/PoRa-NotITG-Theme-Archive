			local Diff = GAMESTATE:GetCurrentSteps(PLAYER_1):GetDifficulty()+1
			for i=1,table.getn(DiffColorTable) do
				if Diff == i then
					self:diffuse( DiffColorTable[i][2][1],DiffColorTable[i][2][2],DiffColorTable[i][2][3],DiffColorTable[i][2][4] )
					self:settext( DiffColorTable[i][1] )
					self:y(SCREEN_CENTER_Y+50)
					self:zoom(0.5)
				end
			end

            self:zoom(0.4)
            self:y(SCREEN_CENTER_Y+45)

		else
			self:settext('No data')
			self:diffuse(1,1,1,0.5)
		end

		self:queuecommand('AnimationStart')
		end"
