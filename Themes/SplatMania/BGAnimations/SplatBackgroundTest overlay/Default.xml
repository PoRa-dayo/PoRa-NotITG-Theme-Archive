<ActorFrame><children>
<Layer File="../Background" />

	<Layer
		Font="Paintball"
		Text=""
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X+290)
		self:y(SCREEN_CENTER_Y+220)
		self:horizalign('right')
		self:vertalign('bottom')
		self:zoom(0.4)
		end"
		/>

		<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Paint Splats/Splat1')"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoom(0.5)
		self:diffuse(0,1,1,1)
		end"
		/>

	<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Cursor.sprite')"
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X-80)
		self:y(SCREEN_CENTER_Y+50)
		self:rotationz(45)
		self:effectclock('bgm')
		self:effectperiod(1)
		self:diffusetopedge(1,0.5,0.5,1)
		self:diffusebottomedge(1,0.8,0.3,1)
		end"
		/>
	<Layer
		Font="Paintball"
		Text="Botón"
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoom(0.9)
		self:shadowlength(1)
		end"
		/>

		<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Tiles/MiniSquidTile')"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_TOP+10)
		self:zoom(1)
		self:diffuse(0,0.52,0.52,1)
		self:zoomx(20)
		self:fadebottom(0.2)
		-- Aqui hacemos que el fondo se duplique por si mismo.
		self:customtexturerect(0,0,20,1);
		-- Haremos que el fondo se mueva en la pantalla.
    	self:texcoordvelocity(0,0.1);
		end"
		/>
	<Layer
		Font="Paintball"
		Text="Pantalla de prueba"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+20)
		self:y(SCREEN_TOP+20)
		self:zoom(0.5)
		self:horizalign('left')
		self:shadowlength(1)
		end"
		/>

		<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','DialogBox')"
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_BOTTOM-100)
		self:effectclock('bgm')
		self:zoom(0.8)
		self:effectperiod(1)
		self:diffuse(0.2,0.2,0.2,0.9)
		end"
		/>


	<Layer
		Font="Paintball"
		Text="Person Name"
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X-250)
		self:y(SCREEN_BOTTOM-150)
		self:horizalign('left')
		self:zoom(0.4)
		self:diffuse(1,1,0,1)
		self:shadowlength(1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="Let's Test an animated background!"
		OnCommand="%function(self)
		
		self:x(SCREEN_CENTER_X-220)
		self:y(SCREEN_BOTTOM-80)
		self:horizalign('left')
		self:zoom(0.4)
		self:shadowlength(1)
		end"
		/>
</children></ActorFrame>