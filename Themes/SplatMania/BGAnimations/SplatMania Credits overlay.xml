<ActorFrame><children>

	<Layer File="Background" />
		
		<Layer Type="ActorFrame" InitCommand="%function(self)
		self:x(SCREEN_RIGHT+3)
		self:y(SCREEN_CENTER_Y)
		self:addx(2000) self:decelerate(1) self:addx(-2000)
	end"
	OffCommand="%function(self) self:accelerate(1) self:addx(2000) end"><children>
	<Layer File="@ThemeFile('SongSelection/SongListBackground')"
		OnCommand="%function(self)
		self:horizalign('right')
		self:zoom(0.9)
		self:customtexturerect(0,0,1,1);
		self:texcoordvelocity(0,0.05/2);
		self:diffusealpha(0.5)
		self:cropleft(0.01)
		end"
		/>

	<Layer File="@ThemeFile('SongSelection/SongListBackground')"
		OnCommand="%function(self)
		self:horizalign('right')
		self:zoom(0.9)
		self:customtexturerect(0,0,1,1);
		self:texcoordvelocity(0,0.05);
		self:diffusealpha(0.5)
		self:cropleft(0.01)
		end"
		/>

	<Layer File="@ThemeFile('Tiles/MapTile')"
		OnCommand="%function(self)
		self:horizalign('left')
		self:x(-450)
		self:zoom(0.7)
		self:customtexturerect(0,0,1,1);
		self:texcoordvelocity(0,0.08/2);
		self:diffusealpha(0.2)
		self:cropleft(0.01)
		end"
		/>

	<Layer File="@ThemeFile('Tiles/MapTile')"
		OnCommand="%function(self)
		self:horizalign('left')
		self:x(-450)
		self:zoom(0.9)
		self:customtexturerect(0,0,1,1);
		self:texcoordvelocity(0,0.05/2);
		self:diffusealpha(0.3)
		self:cropleft(0.01)
		end"
		/>
	</children></Layer>

