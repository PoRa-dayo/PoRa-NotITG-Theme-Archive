<ActorFrame><children>

	<Layer File="@ThemeFile('SongSelection/SongInfo')"
		OnCommand="%function(self)
		self:x(0)
		self:y(0)
		self:zoom(1.1)
		self:blend('WeightedMultiply')
		end"
		/>

	<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Tiles/MiniSquidTile')"
		OnCommand="%function(self)
		self:x(0)
		self:y(0)
		self:zoom(1)
		self:diffuse(0,0.52,0.52,1)
		self:fadebottom(0.2)
		self:fadetop(0.2)
		self:zoomx(5)
		-- Aqui hacemos que el fondo se duplique por si mismo.
		self:customtexturerect(0,0,5,1);
		self:croptop(0.23)
		self:cropright(0.08)
		self:cropleft(0.08)
		-- Haremos que el fondo se mueva en la pantalla.
    	self:texcoordvelocity(0,0.1);
		end"
		/>

	<Layer File="@ThemeFile('SongSelection/SongInfo')"
		OnCommand="%function(self)
		self:x(3)
		self:y(0)
		self:zoom(1.1)
		self:fadeleft(1)
		end"
		/>

	<Layer File="@ThemeFile('SongSelection/SongInfo')"
		OnCommand="%function(self)
		self:x(-3)
		self:y(0)
		self:zoom(1.1)
		self:faderight(1)
		end"
		/>

	<Layer File="@ThemeFile('SongSelection/SongInfo')"
		OnCommand="%function(self)
		self:x(3)
		self:y(0)
		self:zoom(1.1)
		self:cropbottom(0.7)
		self:fadetop(0.5)
		end"
		/>

	<Layer File="@ThemeFile('SongSelection/SongInfo')"
		OnCommand="%function(self)
		self:x(3)
		self:y(0)
		self:zoom(1.1)
		self:croptop(0.7)
		self:fadetop(0.5)
		end"
		/>

</children></ActorFrame>