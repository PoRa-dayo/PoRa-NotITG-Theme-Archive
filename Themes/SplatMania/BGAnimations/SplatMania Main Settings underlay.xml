	<Layer Type="ActorFrame" OnCommand="%function(self) Center(self); self:zoom(1.5) self:addy(SCREEN_CENTER_Y*2); self:decelerate(0.5) self:addy(-SCREEN_CENTER_Y*2) end"><children>
        <Layer File="@ThemeFile('OptionsBG/MainOptionsFrame')" OnCommand="%function(self) self:diffuse(0,0,0,1) end" />
        <Layer File="@ThemeFile('OptionsBG/MainOptionsFrame')" />
    </children></Layer>

    <Layer Type="ActorFrame" OnCommand="%function(self)
    self:y(SCREEN_CENTER_Y-155) self:x(SCREEN_CENTER_X-240 ) self:addy(-400) self:decelerate(0.5) self:addy(400) end"><children>
        <Layer File="@ThemeFile('OptionsBG/OptionTagSelected ')" OnCommand="%function(self) self:zoom(1.5) end" />
        <Layer Font="Splat1" Text="@THEME:GetMetric('MainOptions', 'HeaderText')" OnCommand="%function(self) self:y(-5) self:zoom(.6) self:shadowlength(2) end" />
    </children></Layer>
    
    <Layer Type="ActorFrame" OnCommand="%function(self)
    self:diffusealpha(0.7) self:y(SCREEN_CENTER_Y-155) self:x(SCREEN_CENTER_X-80 ) self:addy(-400) self:decelerate(0.5) self:addy(400) end"><children>
        <Layer File="@ThemeFile('OptionsBG/OptionTag ')" OnCommand="%function(self) self:zoom(1.5) end" />
        <Layer Font="Splat1" Text="@THEME:GetMetric('GameplayOptions', 'HeaderText')" OnCommand="%function(self) self:y(-5) self:zoom(.6) self:shadowlength(2) end" />
    </children></Layer>

    <Layer Type="ActorFrame" OnCommand="%function(self)
    self:diffusealpha(0.7) self:y(SCREEN_CENTER_Y-155) self:x(SCREEN_CENTER_X+80 ) self:addy(-400) self:decelerate(0.5) self:addy(400) end"><children>
