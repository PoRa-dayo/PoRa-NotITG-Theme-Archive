<ActorFrame><children>

	<Layer
		Type="Quad"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoomto(SCREEN_WIDTH,SCREEN_HEIGHT,0,0)
		self:diffuse(0,0,0,0.6)
		end"
		/>

	<!-- <Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Graffiti/Inkling')"
		OnCommand="%function(self)
		self:x(SCREEN_RIGHT-120)
		self:y(SCREEN_CENTER_Y)
		self:zoom(1)
		self:fadeleft(0.2)
		end"
		/> -->


		<Layer
		File="@THEME:GetPath(EC_GRAPHICS,'','Tiles/MiniSquidTile')"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_TOP+10)
		self:zoom(1)
		self:diffuse(0,0.52,0.52,1)
		self:zoomx(20)
		self:fadebottom(0.2)
		-- Aqui hacemos que el fondo se duplique por si mismo.
		self:customtexturerect(0,0,20,1);
		-- Haremos que el fondo se mueva en la pantalla.
    	self:texcoordvelocity(0,0.1);
		end"
		/>
	<Layer
		Font="Paintball"
		Text="@GrabTransText('AboutSplatMania', 'OverlayText', 'HeaderText')"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+20)
		self:y(SCREEN_TOP+20)
		self:zoom(0.5)
		self:horizalign('left')
		self:shadowlength(1)
		end"
		/>

		



		<!-- Logo time! --->

	<Layer Type="ActorFrame" InitCommand="x,SCREEN_LEFT+150;y,SCREEN_CENTER_Y-110;zoom,0.5"><children>
		<Layer Type="ActorFrame"><children>
	<Layer File="@ThemeFile('SplatSelectGameMode scroll choice1/IconRegular')"
		OnCommand="%function(self)
		self:y(0)
		self:x(-100)
		self:zoom(0.4)
		self:rotationz(-20)
		self:faderight(0.5)
		end"
		/>
	</children></Layer>

	<Layer Type="ActorFrame" OnCommand="y,0"><children>	
		<Layer File="@ThemeFile('SplatManiaLogo')"
			OnCommand="%function(self)
			self:y(15)
			self:x(100)
			self:zoom(0.6)
			end"
			/>
		</children></Layer>
	</children></Layer>

		<!-- Logo end --->


	<Layer
		Font="Splat2"
		Text="@GrabTransText('AboutSplatMania', 'OverlayText', 'MadeBy')"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+185)
		self:y(SCREEN_CENTER_Y-80)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Version '..SplatoonInfo['Version']"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+45)
		self:y(SCREEN_CENTER_Y-38)
		self:horizalign('left')
		self:zoom(0.4)
		self:shadowlength(1)
		self:diffusebottomedge(0,1,1,1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Compiled on '..SplatoonInfo['VersionDate'][1]..'/'..SplatoonInfo['VersionDate'][2]..'/'..SplatoonInfo['VersionDate'][3]"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+45)
		self:y(SCREEN_CENTER_Y-24)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		self:diffusebottomedge(1,1,0,1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Programming\n '..SplatoonInfo['Programming']"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+45)
		self:y(SCREEN_CENTER_Y+8)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Sound Effect Management\n '..SplatoonInfo['SoundManager']"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+135)
		self:y(SCREEN_CENTER_Y+8)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Graphic Management\n '..SplatoonInfo['GraphicRipping']"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+45)
		self:y(SCREEN_CENTER_Y+68)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@'Font\n'..SplatoonInfo['FontCreator']"
		OnCommand="%function(self)
		
		self:x(SCREEN_LEFT+45)
		self:y(SCREEN_CENTER_Y+128)
		self:horizalign('left')
		self:zoom(0.3)
		self:shadowlength(1)
		end"
		/>

		<Layer File="MenuButtons.xml" OnCommand="%function(self)
		ShowMove = false
		ShowStart = true
		ShowReturn = false
		end" />

</children></ActorFrame>