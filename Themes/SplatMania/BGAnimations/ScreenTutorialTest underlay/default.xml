<ActorFrame><children>

	<ActorFrame OnCommand="fov,120"><children>
		<Layer Type="Quad"
			InitCommand="zoomto,SCREEN_WIDTH*4,SCREEN_HEIGHT*4;diffuse,0,0,0,1"
			OnCommand="%function(self)
			GAMESTATE:ApplyGameCommand('mod, 2.5x, failoff, contrast')
			end"
			/>
	<Layer
		File="../Background/Icon1"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoom(2)
		self:rotationz(45)
		self:rotationy(10)
		self:rotationx(-55)
		self:fadeleft(0.5)
		self:diffuse(math.random(0.9,1),math.random(0.9,1),math.random(0.9,1),0.3)
		self:customtexturerect(0,0,5*2,5*2);
    	self:texcoordvelocity(0.1,0.1);
		end"
		/>
	</children></ActorFrame>

	<Layer
		File="../Background/Foreground"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoom(2)
		self:customtexturerect(0,0,7*2,7*2);
		end"
		/>

	<Layer
		Font="Paintball"
		Text="@GrabTransText('Tutorial', 'HelpText', 'Text1')"
		OnCommand="%function(self)
		
		self:x(SCREEN_RIGHT-100)
		self:y(SCREEN_CENTER_Y)
		self:horizalign('right')
		self:zoom(0.4)
		self:shadowlength(1)
		self:diffusealpha(0)
		self:queuecommand('fadeinout')
		end"
		fadeinoutCommand="%function(self)
		self:diffusealpha(0)
		self:sleep(0.5)
		self:linear(0.5)
		self:diffusealpha(1)
		self:sleep(1.5)
		self:linear(0.5)
		self:diffusealpha(0)
		end"
		/>

