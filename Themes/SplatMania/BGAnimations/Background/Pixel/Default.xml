<ActorFrame><children>

	<Layer
		Type="Quad"
		OnCommand="%function(self)
		self:x(SCREEN_CENTER_X)
		self:y(SCREEN_CENTER_Y)
		self:zoomto(SCREEN_WIDTH+3,SCREEN_HEIGHT,0,0)
		self:diffuse(0,0,0.3,1)
		end"
		/>

	<Layer File="BGLayer" OnCommand="%function(self)
	Center(self);
	TileAmmount = 5
	self:zoom(TileAmmount)
	self:customtexturerect(0,0,TileAmmount,TileAmmount);
	self:texcoordvelocity(0,-0.1);
	self:SetTextureFiltering(false)
	end"
	/>

	<Layer File="PlatformTile" OnCommand="%function(self)
	Center(self);
	self:y(100)
	self:x(0)
	self:horizalign('left')
	self:zoom(2)
	self:diffusealpha(0.4)
	self:vertalign('top')
	self:SetTextureFiltering(false)
	end"
	/>

	<Layer File="PlatformTile" OnCommand="%function(self)
	Center(self);
	self:y(SCREEN_BOTTOM-150)
	self:x(SCREEN_CENTER_X)
	self:zoom(2)
	self:diffusealpha(0.4)
	self:SetTextureFiltering(false)
	end"
	/>

	<Layer File="PlatformTile" OnCommand="%function(self)
	Center(self);
	self:y(180)
	self:x(SCREEN_RIGHT)
	self:horizalign('right')
	self:zoom(2)
	self:diffusealpha(0.4)
	self:vertalign('top')
	self:SetTextureFiltering(false)
	end"
	/>

	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />
	<Layer File="SquidFlow.xml" OnCommand="%function(self) Hib = math.random(2,8) end" />

<Layer Type="ActorFrame" InitCommand="bob;effectmagnitude,10,0,0;effectoffset,0.5;effectperiod,10"><children>
 <Layer Type="ActorFrame" InitCommand="bob;effectmagnitude,0,10,0;effectperiod,10"><children>

	<Layer File="AcidBody" OnCommand="%function(self)
	Center(self);
	self:y(SCREEN_BOTTOM-100)
	self:vertalign('top')
	TileAmmount = 80
	self:zoomy(80*2)
	self:zoomx(TileAmmount*2)
	self:customtexturerect(0,0,TileAmmount,TileAmmount);
	self:texcoordvelocity(0,0);
	self:SetTextureFiltering(false)
	end"
	/>

	<Layer File="AcidTop" OnCommand="%function(self)
	Center(self);
	self:y(SCREEN_BOTTOM-100)
	TileAmmount = 80
	self:zoomy(2)
	self:zoomx(TileAmmount*2)
	self:customtexturerect(0,0,TileAmmount,1);
	self:texcoordvelocity(0,0);
	self:SetTextureFiltering(false)
	end"
	/>
	</children></Layer>
</children></Layer>

