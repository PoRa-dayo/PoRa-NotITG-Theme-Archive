			/>
		</children></ActorFrame>
		
		<ActorFrame Condition="GAMESTATE:IsPlayerEnabled(PLAYER_2)" OnCommand="x,SCREEN_RIGHT-42;y,SCREEN_TOP+27;zoom,0.4"><children>
			<Actor
				File="@THEME:GetPath(EC_GRAPHICS,'','GameplayDifficulty')"
				OnCommand="zoomx,-1;animate,0;playcommand,Update"
				CurrentStepsP1ChangedMessageCommand="playcommand,Update"
				CurrentStepsP2ChangedMessageCommand="playcommand,Update"
				UpdateCommand="%function(self,parent) SetDifficultyFrameFromSteps(self, PLAYER_2) end"
			/>
		</children></ActorFrame>
		
	</children> </Layer>


	<Layer
			File="@THEME:GetPath(EC_GRAPHICS,'','Button')"
			OnCommand="x,SCREEN_CENTER_X;y,SCREEN_TOP+46;zoom,0.15;shadowlength,0;queuecommand,ApplyColor"
			ApplyColorCommand="%function(self)
			if GAMESTATE:GetCurrentSong():IsLong() then
				self:diffuse(1,0.5,0,1)
			end
			if GAMESTATE:GetCurrentSong():IsMarathon() then
				self:diffuse(1,0.2,0,1)
			end
			end"
			TweenOffCommand="bouncebegin,0.3;zoom,0"
			OffCommand="queuecommand,TweenOff"
			ShowGameplayTopFrameMessageCommand="playcommand,TweenOn"
			HideGameplayTopFrameMessageCommand="playcommand,TweenOff"
		/>

	<Layer
			Type="BitmapText"
			Font="Splat2"
			OnCommand="%function(self)
			self:x(SCREEN_CENTER_X)
			self:y(SCREEN_TOP+45)
			self:zoom(0.5)
			self:queuecommand('Update')
			end"
			InitCommand="animate,0;"
			CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self)
			local timeintimer = self:GetSecsIntoEffect();
            if GAMESTATE:GetCurrentSong() then
                local totaltimer = GAMESTATE:GetCurrentSong():StepsLengthSeconds()
                self:effectclock('music')
                if totaltimer >= 3600 then
                    self:settext(SecondsToHHMMSS(totaltimer-timeintimer))
                        if timeintimer >= totaltimer-60 then
                            self:decelerate(0.2)
                            self:zoom(0.5)
                        end
                        if timeintimer >= totaltimer then
                            self:diffuse(1,1,0,1)
                            self:settext(SecondsToHHMMSS(0))
                        end
                else
                    self:settext(SecondsToMMSS(totaltimer-timeintimer))
                        if timeintimer >= totaltimer-60 then
                            self:diffuse(1,1,0,1)
                            self:settext(SecondsToMMSS(totaltimer-timeintimer))
                        end
                        if timeintimer >= totaltimer then
                            self:diffuse(1,1,0,1)
                            self:settext(SecondsToMMSS(0))
                        end
                end
            end

			self:sleep(0.1)
			self:queuecommand('Update')
			end"
			TweenOffCommand="bouncebegin,0.3;zoom,0"
			OffCommand="queuecommand,TweenOff"
			ShowGameplayTopFrameMessageCommand="playcommand,TweenOn"
			HideGameplayTopFrameMessageCommand="playcommand,TweenOff"
		/>



