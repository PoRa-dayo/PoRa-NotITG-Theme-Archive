	<Layer Type="ActorFrame"
		OnCommand="x,SCREEN_CENTER_X;y,SCREEN_TOP+24;addy,-100;sleep,0.5;zoom,0.6;queuecommand,TweenOn"
		OffCommand="queuecommand,TweenOff"
		ShowGameplayTopFrameMessageCommand="playcommand,TweenOn"
		HideGameplayTopFrameMessageCommand="playcommand,TweenOff"
		TweenOnCommand="decelerate,0.8;addy,+100"
		TweenOffCommand="accelerate,0.8;addy,-100"
		> <children>

		<Layer
			Type="BitmapText"
			Font="Paintball"
			OnCommand="y,-18;zoom,.5;shadowlength,0"
			InitCommand="animate,0;playcommand,Update"
			CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self)
                if GAMESTATE:GetCurrentSong() then
                    local song = GAMESTATE:GetCurrentSong();
                    self:settext(song:GetDisplayMainTitle())
                    if string.len( string.sub(song:GetDisplayFullTitle(), string.len(song:GetDisplayMainTitle()) + 1) ) < 1 then
                        self:zoom(0.7)
                        self:y(-13)
                    end
                end
			end"
		/>

		<!-- Subtitle Display 

		How it works: (Explained by HeySora.)

		Get the length of the string returned by GetDisplayMainTitle
		substring the string returned by the GetDisplayFullTitle
		Like, the start index will be the length of GetDisplayMainTitle + 2 (to remove the space, and start right after)(editado)
		
		string.sub(song:GetDisplayFullTitle(), string.len(song:GetDisplayMainTitle()) + 2);

		The code will look like that ^
		
		What string.sub does is that it returns a portion of the string. for example :
		
		string.sub('Hello', 3); -- Returns 'llo', because it starts reading at the 3rd letter
		
		GetDisplayFullTitle is returning the title, a space, and the subtitle
		-->

		<Layer
			Type="BitmapText"
			Font="Paintball"
			OnCommand="%function(self)
                if GAMESTATE:GetCurrentSong() then
                    local song = GAMESTATE:GetCurrentSong();
                    self:y(-5)
                    self:zoom(0.5)
                    self:shadowlength(0)
                    self:settext(string.sub(song:GetDisplayFullTitle(), string.len(song:GetDisplayMainTitle()) + 2))
                end
            end"
			InitCommand="animate,0;playcommand,Update"
			CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self)
            if GAMESTATE:GetCurrentSong() then
                local song = GAMESTATE:GetCurrentSong();
                string.sub(song:GetDisplayFullTitle(), string.len(song:GetDisplayMainTitle()) + 1);
            end
			end"
		/>
	</children> </Layer>
    
    <!-- song num for course -->
    <Layer
			Type="BitmapText"
			Font="Paintball"
            Condition="GAMESTATE:IsCourseMode()"
			OnCommand="%function(self)
                local songind = GAMESTATE:GetCourseSongIndex()
                if songind then
                    self:y(65)
                    self:x(SCREEN_CENTER_X)
                    self:zoom(0.4)
                    self:shadowlength(0)
                    self:settext('Song '..songind+1)
                end
            end"
            CurrentStepsP1ChangedMessageCommand="playcommand,Update"
            CurrentStepsP2ChangedMessageCommand="playcommand,Update"
            CurrentSongChangedMessageCommand="playcommand,Update"
			UpdateCommand="%function(self)
                local songind = GAMESTATE:GetCourseSongIndex()
                if songind then
                    self:y(65)
                    self:x(SCREEN_CENTER_X)
                    self:zoom(0.4)
                    self:shadowlength(0)
                    self:settext('Song '..songind+1)
                end
            end"
			end"
		/>
	</children> </Layer>

	<!-- Difficulty: -->
