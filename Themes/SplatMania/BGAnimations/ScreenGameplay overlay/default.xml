    --finally decided to fix the lifebar with ActorProxies
    --lifebar p1
    
    <Layer
        File="@THEME:GetPath(EC_GRAPHICS,'LifeMeter','mask')"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="x,SCREEN_LEFT+75;y,SCREEN_TOP+47;zoom,0.55;zwrite,1;blend,noeffect"
    />
    
    <Layer
        Type="ActorProxy"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="%function(self)
            self:sleep(0.1)
			self:queuecommand('Capture')
        end"
        CaptureCommand="%function(self)
            local life = SCREENMAN:GetTopScreen():GetChild('LifeP1');
            self:SetTarget(life)
            self:y(-4269)
        end"
    />
    
    <Layer
        File="@THEME:GetPath(EC_GRAPHICS,'LifeMeter','mask')"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        OnCommand="x,SCREEN_LEFT+75;y,SCREEN_TOP+47;zoom,0.55;zwrite,1;blend,noeffect"
    />
    
    --GetLife just doesn't exist in Battle mode, fun
    <Layer Type="Quad" OnCommand="hidden,1;stretchto,0,0,60,60;x,SCREEN_LEFT+75;y,SCREEN_TOP+47;diffuseshift;effectcolor1,1,0,0,1;effectcolor2,0,0,0,0;effectperiod,0.7;ztest,1;ztestmode,writeonpass;queuecommand,CheckDanger"
        Condition="GAMESTATE:IsPlayerEnabled(PLAYER_1)"
        CheckDangerCommand="%function(self)
            local lf = SCREENMAN:GetTopScreen():GetLife(0)
            if type(lf) == 'number' and lf < 0.3 then
                self:hidden(0)
            else
                self:hidden(1)
            end
            self:sleep(0.2)
			self:queuecommand('CheckDanger')
        end"
    />
    
    
