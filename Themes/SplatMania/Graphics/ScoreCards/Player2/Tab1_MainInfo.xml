<ActorFrame><children>
        <Layer File="../Failed" OnCommand="y,265;x,600;diffusealpha,0;zoom,2;sleep,2;queuecommand,CheckForFail"
        CheckForFailCommand="%function(self)
        if Player2Failed then
            self:bounceend(0.5)
            self:zoom(1)
            self:diffusealpha(1)
        end
        end"
        />
        
        <Layer File="../Success" OnCommand="y,265;x,600;diffusealpha,0;zoom,2;sleep,2;queuecommand,CheckForFail"
        CheckForFailCommand="%function(self)
        if not Player2Failed then
            self:bounceend(0.5)
            self:zoom(1)
            self:diffusealpha(1)
        end
        end"
        />
        <Layer Font="Splat2" Text="Player 2" OnCommand="shadowlength,1;zoom,2.8;y,-460;x,-618" />
        <Layer Font="Splat2" Text="Score:" OnCommand="shadowlength,1;zoom,1.8;y,-80;x,428" />
        <Layer Font="Splat2" Text="Rank" OnCommand="shadowlength,1;zoom,2.2;y,50;x,600" />
        <Layer Font="Splat2" Text="@SCREENMAN:GetTopScreen():GetChild('PlayerOptionsP2'):GetText()" OnCommand="shadowlength,1;zoom,1.4;y,480;x,-780;horizalign,left;maxwidth,SCREEN_WIDTH" />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,0;x,-990;y,-150*(0.95*2);"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 8, 150, -330+(50*0.0), 1, 100, 2, 'Stage', 'Fantastic') end" 
        />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,1;x,-990;y,-150;"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 7, 150, -330+(135*1.0), 1, 100, 2, 'Stage', 'Excellent') end" 
        />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,2;x,-1080;y,-13;"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 6, 150, -330+(135*2.0), 1, 100, 2, 'Stage', 'Great') end" 
        />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,3;x,-1045;y,123;"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 5, 150, -330+(135*3.0), 1, 100, 2, 'Stage', 'Decent') end" 
        />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,4;x,-1015;y,253;"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 4, 150, -330+(135*4.0), 1, 100, 2, 'Stage', 'WayOff') end" 
        />

        <Layer File="@ThemeFile('Judge/'..THEME:GetCurLanguage() )"
        InitCommand="zoom,2.4;horizalign,left;animate,0;setstate,5;x,-1090;y,390;"
        />
        <Layer Font="Splat2Stroke" Text="0"
        InitCommand="horizalign,right;queuecommand,ShowScore"
        ShowScoreCommand="%function(self) RecieveTapNoteScore(self, PLAYER_2, 3, 150, -330+(135*5.0), 1, 100, 2, 'Stage', 'Miss') end" 
        />

        <!-- Holds: Fresh! -->
        <Layer Font="Splat2" Text="0"
        InitCommand="horizalign,left;draworder,90;shadowlength,0;queuecommand,ShowScore;zoom,1.2;y,-300;x,410"
        ShowScoreCommand="%function(self)
        self:settext( 'x  '..GetPSStageStats(PLAYER_2):GetHoldNoteScores(2) )
        end" 
        />

        <!-- Holds: Bad! -->
        <Layer Font="Splat2" Text="0"
        InitCommand="horizalign,left;draworder,90;shadowlength,0;queuecommand,ShowScore;zoom,1.2;y,-240;x,410"
        ShowScoreCommand="%function(self)
        self:settext( 'x  '..GetPSStageStats(PLAYER_2):GetHoldNoteScores(1) )
        end" 
        />
        
        <!-- Mines -->
        <Layer Font="Splat2" Text="0"
        InitCommand="horizalign,left;draworder,90;shadowlength,0;queuecommand,ShowScore;zoom,1.2;y,-180;x,410;maxwidth,180"
        ShowScoreCommand="%function(self)
        self:settext( SCREENMAN:GetTopScreen():GetChild('MinesTextP2'):GetText() )
        end" 
        />

        <Layer Font="Splat2" Text="Score:"
        OnCommand="%function(self)
        self:zoom(2.3);
        self:horizalign('right')
        self:y(-90);
        self:shadowlength(0)
        self:x(500*1.8);
        CalculatePercentage(self, PLAYER_2, 'Cur')
        end"
        />

        <Layer Font="Splat2" Text="Score:"
        OnCommand="%function(self)
        self:zoom(1.7);
        self:horizalign('right')
        self:y(-190);
        self:shadowlength(0)
        self:x(500*1.8);
        self:settext( GetScore(PLAYER_2)..'p' )
        end"
        />
        <!--StepP1LeftPressMessageCommand="stoptweening;decelerate,0.3;diffusealpha,1"
        StepP1RightPressMessageCommand="stoptweening;decelerate,0.3;diffusealpha,0"-->
        
        
        <Layer
                Font="Splat2Stroke" Text=""
                Condition="GAMESTATE:IsPlayerEnabled(PLAYER_2)"
                InitCommand="zoom,1.8;shadowlength,2;horizalign,right;y,-480;x,800"
                OnCommand="%function(self)
                if GAMESTATE:IsHumanPlayer(PLAYER_1) then
                        for i=1,table.getn(DiffColorTable) do
                                if PlrDiff(PLAYER_1)+1 == i then
                                        self:diffuse( DiffColorTable[i][2][1],DiffColorTable[i][2][2],DiffColorTable[i][2][3],DiffColorTable[i][2][4] )
                                        self:settext( DiffColorTable[i][1]..' - '..GAMESTATE:GetCurrentSteps(PLAYER_2):GetMeter() )
                                end
                        end
                end
                end"
        />

</children></ActorFrame>